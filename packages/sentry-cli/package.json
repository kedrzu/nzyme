{
    "name": "@nzyme/sentry-cli",
    "version": "0.14.0",
    "private": true,
    "description": "Sentry CLI integration",
    "license": "MIT",
    "author": "Michał Kędrzyński <m.kedrzynski@gmail.com>",
    "repository": {
        "type": "git",
        "url": "https://github.com/kedrzu/nzyme.git"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "sideEffects": false,
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./*.js": {
            "types": "./dist/*.d.ts",
            "import": "./dist/*.js",
            "source": "./src/*.ts",
            "default": "./dist/*.js"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "@nzyme/cli": "0.14.0",
        "@nzyme/github-cli": "0.14.0",
        "@nzyme/logging": "0.14.0",
        "chalk": "6.0.0",
        "node-fetch": "3.3.2",
        "open": "11.0.0"
    },
    "devDependencies": {
        "@nzyme/eslint": "0.14.0",
        "@nzyme/tsconfig": "0.14.0",
        "@types/bun": "^1.3.11",
        "@typescript/native-preview": "^7.0.0-dev.20260707.2",
        "eslint": "10.8.0",
        "oxfmt": "0.62.0"
    },
    "depcheck": {
        "ignoreDeps": [
            "typescript"
        ]
    },
    "nzyme": {
        "cjs": true
    }
}
