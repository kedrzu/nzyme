{
    "name": "@nzyme/eslint",
    "version": "0.14.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/kedrzu/nzyme.git"
    },
    "license": "MIT",
    "author": "Michał Kędrzyński <m.kedrzynski@gmail.com>",
    "sideEffects": false,
    "type": "module",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "lint": "prettier ./src --write && yarn tsc --noEmit --project tsconfig.check.json && eslint . --fix --cache",
        "build:esm": "tsc --build ./tsconfig.esm.json"
    },
    "dependencies": {
        "@eslint/js": "9.39.2",
        "@typescript-eslint/parser": "^8.50.0",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jsdoc": "^62.0.0",
        "eslint-plugin-monorepo": "^0.3.2",
        "eslint-plugin-package-json": "^0.88.1",
        "eslint-plugin-perfectionist": "^5.3.1",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-vue": "^10.6.2",
        "eslint-plugin-workspaces": "^0.11.1",
        "globals": "^17.0.0",
        "jsonc-eslint-parser": "^2.4.2",
        "typescript-eslint": "^8.50.0",
        "vue-eslint-parser": "^10.2.0"
    },
    "devDependencies": {
        "@nzyme/tsconfig": "0.14.0",
        "typescript": "^5.9.3"
    },
    "publishConfig": {
        "access": "public"
    }
}
