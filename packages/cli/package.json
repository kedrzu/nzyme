{
    "name": "@nzyme/cli",
    "version": "0.15.1",
    "description": "The nzyme binary: monorepo, localise, index, quiet-run and other repo commands",
    "license": "MIT",
    "author": "Michał Kędrzyński <m.kedrzynski@gmail.com>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/kedrzu/nzyme.git"
    },
    "bin": {
        "nzyme": "bin/cli.js"
    },
    "files": [
        "dist",
        "bin"
    ],
    "type": "module",
    "exports": {
        "./*.js": {
            "types": "./dist/*.d.ts",
            "source": "./src/*.ts",
            "import": "./dist/*.js",
            "default": "./dist/*.js"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsgo --build tsconfig.esm.json",
        "format": "oxfmt ./src > /dev/null"
    },
    "dependencies": {
        "@nzyme/cli-core": "workspace:*",
        "@nzyme/i18n-compiler": "workspace:*",
        "@nzyme/project-utils": "workspace:*",
        "@nzyme/utils": "workspace:*",
        "@types/fs-extra": "^11.0.4",
        "chalk": "^6.0.1",
        "chokidar": "^6.0.0",
        "comment-json": "^5.0.0",
        "compare-versions": "^6.1.1",
        "depcheck": "^1.4.7",
        "enquirer": "^2.4.1",
        "execa": "^10.2.0",
        "fs-extra": "^11.4.1",
        "latest-version": "^9.0.0",
        "lodash.merge": "^4.6.2",
        "type-fest": "^5.10.0",
        "typescript": "^6.0.3"
    },
    "devDependencies": {
        "@nzyme/tsconfig": "workspace:*",
        "@types/lodash.merge": "4.6.9",
        "@types/node": "26.6.6",
        "@typescript/native-preview": "^7.0.0-dev.20260707.2",
        "oxfmt": "0.77.0"
    },
    "engines": {
        "node": ">=20"
    }
}
