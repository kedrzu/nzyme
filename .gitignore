
# Dependency directories
node_modules/
dist/
dist-cjs/
.DS_Store

# TypeScript cache
*.tsbuildinfo

# Eslint cache
.eslintcache

.env
.env.*
!.env.example
.nzyme

.nx/cache
.nx/workspace-data

# Agent scratch space: command logs, specs, plans, reviews
.context/

# these are generated by nzyme
tsconfig.json
tsconfig.cjs.json
