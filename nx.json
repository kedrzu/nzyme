{
    "$schema": "./node_modules/nx/schemas/nx-schema.json",
    "parallel": 5,
    "tui": {
        "enabled": false
    },
    "namedInputs": {
        "default": ["{projectRoot}/**/*", "sharedGlobals"],
        "sharedGlobals": [
            "{workspaceRoot}/package.json",
            "{workspaceRoot}/bun.lock",
            "{workspaceRoot}/nx.json",
            "{workspaceRoot}/tsconfig.json"
        ],
        // Listed out rather than as `["default", "!…"]`, matching the consuming monorepo: the
        // exclusions must sit next to the globs they narrow.
        "production": [
            "{projectRoot}/**/*",
            "sharedGlobals",
            "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)",
            "!{projectRoot}/**/__snapshots__/**",
            "!{projectRoot}/**/*.snap"
        ],
        "localEnvironment": [
            {
                "env": "ENV"
            }
        ]
    },
    "targetDefaults": {
        "build": {
            "cache": true,
            "inputs": ["production", "^production", "localEnvironment"],
            "outputs": ["{projectRoot}/dist", "{projectRoot}/.output", "{projectRoot}/*.tsbuildinfo"],
            "dependsOn": ["^build"]
        },
        "typecheck": {
            "cache": true,
            "inputs": ["default", "^default", "localEnvironment"]
        },
        "dev": {
            "cache": false,
            "continuous": true
        },
        "watch": {
            "cache": false,
            "continuous": true
        }
    },
    "release": {
        "projects": ["packages/*", "!@nzyme/logging-ui"],
        "releaseTag": {
            "pattern": "v{version}"
        },
        "version": {
            "conventionalCommits": true,
            "git": {
                "commit": false,
                "tag": false,
                "stageChanges": false
            }
        },
        "changelog": {
            "workspaceChangelog": {
                "createRelease": false
            },
            "projectChangelogs": false,
            "git": {
                "commit": false,
                "tag": false,
                "stageChanges": false
            }
        }
    },
    // Nx CLI usage analytics go to www.google-analytics.com; nothing here needs them.
    "analytics": false,
    "defaultBase": "origin/main",
    // nzyme is checked out as a submodule in many repos and worktrees, and every copy spawned its own
    // daemon that never exits and keeps watching the file tree (CPU and battery drain). Only an
    // explicit `NX_DAEMON=true` overrides this.
    "useDaemonProcess": false
}
