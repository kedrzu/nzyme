{
    "private": true,
    "repository": {
        "type": "git",
        "url": "https://github.com/kedrzu/nzyme.git"
    },
    "license": "MIT",
    "author": "Michał Kędrzyński <m.kedrzynski@gmail.com>",
    "type": "module",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "clean": "del \"**/dist\" \"**/dist-cjs\" \"**/.turbo\" \"**/.tsbuildinfo\" \"**/*.tsbuildinfo\" \"!**/node_modules/**\"",
        "coverage": "vitest run --coverage",
        "dev": "bun && bun monorepo && bun watch",
        "groundup": "bun && bun clean &&bun setup && bun build",
        "monorepo": "nzyme monorepo",
        "release": "nx release --yes",
        "setup": "turbo run build --filter=@nzyme/cli && bun monorepo",
        "test": "vitest run",
        "update": "bun upgrade-interactive",
        "update:self": "bun set version berry",
        "watch": "tsc --build --watch"
    },
    "dependencies": {
        "tslib": "2.8.1"
    },
    "devDependencies": {
        "@nx/js": "21.2.1",
        "@nzyme/cli": "0.14.0",
        "@swc-node/register": "1.10.10",
        "@swc/core": "1.12.6",
        "del-cli": "6.0.0",
        "eslint": "9.29.0",
        "nx": "21.1.3",
        "prettier": "3.5.3",
        "turbo": "2.5.4",
        "typescript": "5.8.3",
        "vitest": "3.2.4"
    },
    "packageManager": "bun@1.2.4",
    "depcheck": {
        "ignoreDeps": [
            "*"
        ]
    }
}
