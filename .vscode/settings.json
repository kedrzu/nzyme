{
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": true,
    "files.exclude": {
        "**/.git": true,
        // "**/dist": true,
        "**/node_modules/**": true,
        "**/tsconfig.tsbuildinfo": true
    },
    // Allows formatting XML and SVG files by oxfmt
    "files.associations": {
        "*.xml": "html",
        "*.svg": "html"
    },
    "search.exclude": {
        "**/dist": true,
        "**/node_modules/**": true,
        "**/*.code-search": true,
        "bun.lock": true,
        "**/.nx": true,
        ".context": true,
        "**/legacy": true
    },
    "search.followSymlinks": true,
    "javascript.format.enable": false,
    "json.format.enable": false,
    "npm.packageManager": "bun",
    "npm.scriptExplorerAction": "run",
    "typescript.format.enable": false,
    "typescript.tsdk": "node_modules/typescript/lib",
    // ESLint covers Vue rules only; oxlint (via the oxc extension) covers everything else.
    "eslint.useFlatConfig": true,
    "eslint.ignoreUntitled": true,
    "eslint.codeAction.showDocumentation": { "enable": true },
    "eslint.validate": ["vue"],
    "eslint.runtime": "bun",
    "eslint.execArgv": ["--bun"],
    "oxc.enable": true,
    "oxc.lint.run": "onType",
    "bun.test.filePattern": "**/*.test.ts",
    "typescript.enablePromptUseWorkspaceTsdk": true,
    "workbench.colorCustomizations": {
        "activityBar.activeBackground": "#3240bd",
        "activityBar.background": "#3240bd",
        "activityBar.foreground": "#FFEB00",
        "activityBar.inactiveForeground": "#ffffff",
        "activityBarBadge.background": "#000957",
        "activityBarBadge.foreground": "#ffffff",
        "commandCenter.border": "#e7e7e799",
        "sash.hoverBorder": "#3240bd",
        "statusBar.background": "#273295",
        "statusBar.foreground": "#ffffff",
        "statusBarItem.hoverBackground": "#3240bd",
        "statusBarItem.remoteBackground": "#273295",
        "statusBarItem.remoteForeground": "#ffffff",
        "titleBar.activeBackground": "#273295",
        "titleBar.activeForeground": "#ffffff",
        "titleBar.inactiveBackground": "#27329599",
        "titleBar.inactiveForeground": "#e7e7e799"
    },
    "peacock.color": "#273295"
}
