{
    "name": "@nzyme/vue-forms",
    "version": "0.14.0",
    "description": "Vue form state and validation (useForm, useFormFields)",
    "license": "MIT",
    "author": "Michał Kędrzyński <m.kedrzynski@gmail.com>",
    "repository": {
        "type": "git",
        "url": "https://github.com/kedrzu/nzyme.git"
    },
    "files": [
        "src"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "imports": {
        "#css/*": "./css/*"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./shims": {
            "types": "./src/shims.d.ts"
        },
        "./*.js": {
            "types": "./src/*.ts",
            "import": "./src/*.ts",
            "source": "./src/*.ts",
            "default": "./src/*.ts"
        },
        "./*.jsx": {
            "types": "./src/*.tsx",
            "import": "./src/*.tsx",
            "source": "./src/*.tsx",
            "default": "./src/*.tsx"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsgo --build tsconfig.esm.json",
        "format": "oxfmt ./src > /dev/null"
    },
    "dependencies": {
        "@nzyme/dom-utils": "0.14.0",
        "@nzyme/i18n": "0.14.0",
        "@nzyme/i18n-core": "0.14.0",
        "@nzyme/money": "0.14.0",
        "@nzyme/types": "0.14.0",
        "@nzyme/utils": "0.14.0",
        "@nzyme/validation": "0.14.0",
        "@nzyme/vue-i18n": "0.14.0",
        "@nzyme/vue-ioc": "0.14.0",
        "@nzyme/vue-utils": "0.14.0",
        "@vueuse/core": "14.3.0",
        "imask": "7.6.1",
        "libphonenumber-js": "1.13.10",
        "postal-codes-js": "2.5.2",
        "vue": "3.5.40",
        "vue-imask": "7.6.1",
        "vue-router": "5.2.0"
    },
    "devDependencies": {
        "@nzyme/eslint": "0.14.0",
        "@nzyme/tsconfig": "0.14.0",
        "@nzyme/vue-ioc": "0.14.0",
        "@types/bun": "^1.3.13",
        "@types/node": "26.1.1",
        "@typescript/native-preview": "^7.0.0-dev.20260707.2",
        "eslint": "10.7.0",
        "oxfmt": "0.59.0",
        "vite": "7.3.6"
    }
}
