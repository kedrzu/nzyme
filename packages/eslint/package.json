{
    "name": "@nzyme/eslint",
    "version": "0.14.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/kedrzu/nzyme.git"
    },
    "license": "MIT",
    "author": "Michał Kędrzyński <m.kedrzynski@gmail.com>",
    "sideEffects": false,
    "type": "module",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        },
        "./*.js": {
            "types": "./dist/*.d.ts",
            "import": "./dist/*.js",
            "source": "./src/*.ts",
            "default": "./dist/*.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc --build tsconfig.esm.json",
        "lint": "prettier ./src --write > /dev/null && eslint . --fix --cache"
    },
    "dependencies": {
        "@eslint/js": "9.39.2",
        "@typescript-eslint/parser": "8.56.1",
        "eslint": "9.39.2",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-import": "2.32.0",
        "eslint-plugin-jsdoc": "62.5.0",
        "eslint-plugin-monorepo": "0.3.2",
        "eslint-plugin-package-json": "0.88.2",
        "eslint-plugin-perfectionist": "5.4.0",
        "eslint-plugin-react": "7.37.5",
        "eslint-plugin-vue": "10.7.0",
        "eslint-plugin-workspaces": "0.11.1",
        "globals": "17.3.0",
        "jsonc-eslint-parser": "2.4.2",
        "typescript-eslint": "8.55.0",
        "vue-eslint-parser": "10.4.0"
    },
    "devDependencies": {
        "@nzyme/tsconfig": "0.14.0",
        "@types/node": "25.3.3",
        "prettier": "3.8.1",
        "typescript": "5.9.3"
    },
    "publishConfig": {
        "access": "public"
    }
}
