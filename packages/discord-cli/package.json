{
    "name": "@nzyme/discord-cli",
    "version": "0.16.0",
    "description": "Agent-facing Discord CLI commands over the official Discord OpenAPI spec: browse the spec, GET, and write as a bot",
    "license": "MIT",
    "author": "Michał Kędrzyński <m.kedrzynski@gmail.com>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/kedrzu/nzyme.git"
    },
    "files": [
        "dist",
        "openapi.json"
    ],
    "type": "module",
    "sideEffects": false,
    "exports": {
        "./*.js": {
            "types": "./dist/*.d.ts",
            "source": "./src/*.ts",
            "import": "./dist/*.js",
            "default": "./dist/*.js"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsgo --build tsconfig.esm.json",
        "format": "oxfmt ./src > /dev/null",
        "schema": "bun run scripts/fetchSchema.ts && oxfmt openapi.json"
    },
    "dependencies": {
        "@nzyme/cli-core": "workspace:*",
        "@nzyme/openapi-cli": "workspace:*",
        "@nzyme/utils": "workspace:*"
    },
    "devDependencies": {
        "@nzyme/ioc": "workspace:*",
        "@nzyme/tsconfig": "workspace:*",
        "@types/bun": "^1.4.3",
        "@types/node": "26.6.6",
        "@typescript/native-preview": "^7.0.0-dev.20260707.2",
        "clipanion": "^4.0.0-rc.4",
        "oxfmt": "0.77.0"
    }
}
