{
    "name": "@nzyme/cli-core",
    "version": "0.15.1",
    "description": "CLI framework (clipanion-based Command base)",
    "license": "MIT",
    "author": "Michał Kędrzyński <m.kedrzynski@gmail.com>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/kedrzu/nzyme.git"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "source": "./src/index.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./*.js": {
            "types": "./dist/*.d.ts",
            "source": "./src/*.ts",
            "import": "./dist/*.js",
            "default": "./dist/*.js"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsgo --build tsconfig.esm.json",
        "format": "oxfmt ./src > /dev/null"
    },
    "dependencies": {
        "@nzyme/ioc": "workspace:*",
        "@nzyme/logging": "workspace:*",
        "@nzyme/node-utils": "workspace:*",
        "@nzyme/utils": "workspace:*",
        "clipanion": "^4.0.0-rc.4",
        "source-map-support": "^0.5.21"
    },
    "devDependencies": {
        "@nzyme/tsconfig": "workspace:*",
        "@types/node": "26.6.6",
        "@types/source-map-support": "0.5.10",
        "@typescript/native-preview": "^7.0.0-dev.20260707.2",
        "oxfmt": "0.76.0"
    },
    "engines": {
        "node": ">=20"
    }
}
