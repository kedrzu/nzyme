{
    "name": "@nzyme/nuxt-tools",
    "version": "0.14.0",
    "license": "MIT",
    "author": "Michał Kędrzyński <m.kedrzynski@gmail.com>",
    "repository": {
        "type": "git",
        "url": "https://github.com/kedrzu/nzyme.git"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "default": "./dist/index.js",
            "types": "./dist/index.d.ts"
        },
        "./*.js": {
            "types": "./dist/*.d.ts",
            "import": "./dist/*.js",
            "source": "./src/*.ts",
            "default": "./dist/*.js"
        }
    },
    "scripts": {
        "build": "tsc --build tsconfig.esm.json",
        "lint": "eslint . --fix --cache",
        "prettify": "prettier ./src --write > /dev/null"
    },
    "dependencies": {
        "@types/fs-extra": "11.0.4",
        "@types/mime-types": "3.0.1",
        "fs-extra": "11.3.4",
        "mime-types": "3.0.2",
        "nuxt": "4.4.2",
        "vite": "7.3.1"
    },
    "devDependencies": {
        "@nzyme/eslint": "0.14.0",
        "@nzyme/tsconfig": "0.14.0",
        "eslint": "10.1.0",
        "prettier": "3.8.1",
        "typescript": "6.0.2"
    }
}
