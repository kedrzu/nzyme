{
    "name": "@nzyme/rpc",
    "version": "0.14.0",
    "description": "RPC endpoint framework (defineEndpoint, client/server transport)",
    "license": "MIT",
    "author": "Michał Kędrzyński <m.kedrzynski@gmail.com>",
    "repository": {
        "type": "git",
        "url": "https://github.com/kedrzu/nzyme.git"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "sideEffects": false,
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./*.js": {
            "types": "./dist/*.d.ts",
            "import": "./dist/*.js",
            "source": "./src/*.ts",
            "default": "./dist/*.js"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsgo --build tsconfig.esm.json",
        "format": "oxfmt ./src > /dev/null"
    },
    "dependencies": {
        "@nzyme/crypto": "workspace:*",
        "@nzyme/fetch-utils": "workspace:*",
        "@nzyme/ioc": "workspace:*",
        "@nzyme/logging": "workspace:*",
        "@nzyme/types": "workspace:*",
        "@nzyme/utils": "workspace:*",
        "@standard-schema/spec": "1.1.0",
        "ufo": "1.6.4",
        "vitest": "4.1.10"
    },
    "devDependencies": {
        "@nzyme/tsconfig": "workspace:*",
        "@types/connect": "3.4.38",
        "@typescript/native-preview": "^7.0.0-dev.20260707.2",
        "oxfmt": "0.71.0"
    }
}
