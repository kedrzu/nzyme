{
    "name": "@nzyme/google-auth",
    "version": "0.19.0",
    "description": "Google sign-in for nzyme CLIs: an OAuth client and refresh tokens kept in the secret stores, and the shared auth and accounts commands",
    "license": "MIT",
    "author": "Michał Kędrzyński <m.kedrzynski@gmail.com>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/kedrzu/nzyme.git"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "sideEffects": false,
    "exports": {
        "./*.js": {
            "types": "./dist/*.d.ts",
            "source": "./src/*.ts",
            "import": "./dist/*.js",
            "default": "./dist/*.js"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsgo --build tsconfig.esm.json",
        "format": "oxfmt ./src > /dev/null"
    },
    "dependencies": {
        "@nzyme/cli-core": "workspace:*",
        "@nzyme/ioc": "workspace:*",
        "@nzyme/node-utils": "workspace:*",
        "@nzyme/secrets": "workspace:*",
        "google-auth-library": "^11.3.4"
    },
    "devDependencies": {
        "@nzyme/tsconfig": "workspace:*",
        "@types/bun": "^1.4.5",
        "@types/node": "26.6.6",
        "@typescript/native-preview": "^7.0.0-dev.20260707.2",
        "clipanion": "^4.0.0-rc.4",
        "oxfmt": "0.79.0"
    }
}
