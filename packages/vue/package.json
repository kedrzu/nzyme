{
    "name": "@nzyme/vue",
    "version": "0.14.0",
    "license": "MIT",
    "author": "Michał Kędrzyński <m.kedrzynski@gmail.com>",
    "repository": {
        "type": "git",
        "url": "https://github.com/kedrzu/nzyme.git"
    },
    "files": [
        "src"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "source": "./src/index.ts",
            "import": "./src/index.ts",
            "require": "./src/index.ts"
        },
        "./shims": {
            "types": "./src/shims.d.ts"
        },
        "./*.js": "./src/*.ts",
        "./*.jsx": "./src/*.tsx",
        "./*.vue": "./src/*.vue"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsc --build tsconfig.esm.json",
        "lint": "eslint . --fix --cache",
        "format": "oxfmt ./src > /dev/null"
    },
    "dependencies": {
        "@nzyme/dom-utils": "0.14.0",
        "@nzyme/ioc": "0.14.0",
        "@nzyme/types": "0.14.0",
        "@nzyme/utils": "0.14.0",
        "@nzyme/vue-ioc": "0.14.0",
        "@nzyme/vue-utils": "0.14.0",
        "@vueuse/core": "14.2.1",
        "lodash.debounce": "4.0.8",
        "type-fest": "5.5.0",
        "vue": "3.5.30"
    },
    "devDependencies": {
        "@nzyme/eslint": "0.14.0",
        "@nzyme/tsconfig": "0.14.0",
        "@types/lodash.debounce": "4.0.9",
        "@types/node": "25.5.0",
        "eslint": "10.1.0",
        "oxfmt": "0.46.0",
        "typescript": "6.0.2",
        "vite": "7.3.1"
    }
}
