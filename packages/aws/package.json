{
    "name": "@nzyme/aws",
    "version": "0.8.0",
    "sideEffects": false,
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/kedrzu/nzyme.git"
    },
    "author": "Michał Kędrzyński <m.kedrzynski@gmail.com>",
    "type": "module",
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "dist"
    ],
    "main": "./dist/esm/index.js",
    "types": "./dist/esm/index.d.ts",
    "module": "./dist/esm/index.js",
    "exports": {
        ".": {
            "types": "./dist/esm/index.d.ts",
            "default": "./dist/esm/index.js"
        },
        "./*": {
            "types": "./dist/esm/*.d.ts",
            "default": "./dist/esm/*.js"
        }
    },
    "scripts": {
        "build:esm": "tsc --build ./tsconfig.esm.json",
        "build:cjs": "tsc --build ./tsconfig.cjs.json",
        "eslint": "eslint . --fix --cache",
        "smoke:mjs": "node tests/smoke.test.mjs",
        "smoke:cjs": "node tests/smoke.test.cjs"
    },
    "dependencies": {
        "@aws-sdk/client-cloudfront": "^3.764.0",
        "@aws-sdk/client-dynamodb": "^3.758.0",
        "@aws-sdk/client-s3": "^3.758.0",
        "@aws-sdk/client-sqs": "^3.758.0",
        "@nzyme/ioc": "^0.8.0",
        "@nzyme/logging": "^0.8.0",
        "@nzyme/types": "^0.8.0",
        "@nzyme/utils": "^0.8.0",
        "@types/aws-lambda": "^8.10.147",
        "@types/mime-types": "^2.1.4",
        "mime-types": "^2.1.35",
        "s3-sync-client": "^4.3.1",
        "tslib": "^2.8.1"
    },
    "devDependencies": {
        "@nzyme/eslint": "^0.8.0",
        "@nzyme/tsconfig": "^0.8.0",
        "@nzyme/vitest": "^0.8.0",
        "@types/node": "^22.13.10",
        "typescript": "^5.8.2"
    }
}
