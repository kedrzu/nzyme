{
    "name": "@nzyme/project-utils",
    "version": "0.15.1",
    "description": "Monorepo project utilities (getPackages, getProjectRoot)",
    "license": "MIT",
    "author": "Michał Kędrzyński <m.kedrzynski@gmail.com>",
    "repository": {
        "type": "git",
        "url": "https://github.com/kedrzu/nzyme.git"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "source": "./src/index.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./*.js": {
            "types": "./dist/*.d.ts",
            "source": "./src/*.ts",
            "import": "./dist/*.js",
            "default": "./dist/*.js"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsgo --build tsconfig.esm.json",
        "format": "oxfmt ./src > /dev/null"
    },
    "dependencies": {
        "@manypkg/find-root": "3.1.0",
        "@nzyme/utils": "workspace:*",
        "chalk": "6.0.1",
        "dotenv": "18.0.8",
        "execa": "10.2.0",
        "fs-extra": "11.4.1",
        "oxfmt": "0.73.0",
        "parse-gitignore": "2.0.0",
        "pkg-types": "2.3.3"
    },
    "devDependencies": {
        "@nzyme/tsconfig": "workspace:*",
        "@types/fs-extra": "11.0.4",
        "@types/node": "26.6.5",
        "@types/parse-gitignore": "1.0.2",
        "@typescript/native-preview": "^7.0.0-dev.20260707.2"
    }
}
