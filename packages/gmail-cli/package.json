{
    "name": "@nzyme/gmail-cli",
    "version": "0.17.1",
    "description": "Agent-facing Gmail commands: search and read threads as Markdown, Markdown drafts with attachments, label rules, no sending or permanent deletion",
    "license": "MIT",
    "author": "Michał Kędrzyński <m.kedrzynski@gmail.com>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/kedrzu/nzyme.git"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "sideEffects": false,
    "exports": {
        "./*.js": {
            "types": "./dist/*.d.ts",
            "source": "./src/*.ts",
            "import": "./dist/*.js",
            "default": "./dist/*.js"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsgo --build tsconfig.esm.json",
        "format": "oxfmt ./src > /dev/null"
    },
    "dependencies": {
        "@googleapis/gmail": "^22.1.0",
        "@joplin/turndown-plugin-gfm": "^1.0.68",
        "@nzyme/cli-core": "workspace:*",
        "@nzyme/google-auth": "workspace:*",
        "@nzyme/node-utils": "workspace:*",
        "@nzyme/utils": "workspace:*",
        "email-forward-parser": "^1.7.2",
        "email-reply-parser": "^2.3.5",
        "marked": "^18.0.14",
        "nodemailer": "^10.0.12",
        "turndown": "^7.2.2"
    },
    "devDependencies": {
        "@nzyme/secrets": "workspace:*",
        "@nzyme/tsconfig": "workspace:*",
        "@types/bun": "^1.4.3",
        "@types/node": "26.6.6",
        "@types/nodemailer": "^8.0.2",
        "@types/turndown": "^5.0.6",
        "@typescript/native-preview": "^7.0.0-dev.20260707.2",
        "clipanion": "^4.0.0-rc.4",
        "oxfmt": "0.79.0"
    }
}
