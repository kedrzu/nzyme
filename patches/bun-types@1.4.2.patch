+  /**
+   * Matchers reached through `.resolves` / `.rejects`.
+   *
+   * PATCH (nzyme): upstream types these as plain `Matchers`, i.e. returning `void`, which
+   * contradicts Bun's own documentation — it prescribes `await expect(...).rejects.toThrow(...)`.
+   * With the upstream typing, every awaited rejection assertion trips `await-thenable`, so the
+   * choice is between disabling a genuinely useful rule across all test files or dropping the
+   * `await` and diverging from the documented (and Jest/Vitest-portable) form.
+   *
+   * See https://github.com/oven-sh/bun/issues — report upstream and drop this patch once fixed.
+   */
+  export type PromiseMatchers<T = unknown> = {
+    [K in keyof Matchers<T>]: Matchers<T>[K] extends (...args: infer A) => unknown
+      ? (...args: A) => Promise<void>
+      : PromiseMatchers<T>;
+  };
+
