{
    "name": "@nzyme/vue-transitions",
    "version": "0.14.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/kedrzu/nzyme.git"
    },
    "license": "MIT",
    "author": "Michał Kędrzyński <m.kedrzynski@gmail.com>",
    "sideEffects": false,
    "type": "module",
    "exports": {
        ".": {
            "source": "./src/index.ts",
            "import": "./src/index.ts",
            "require": "./src/index.ts"
        },
        "./shims": {
            "types": "./src/shims.d.ts"
        },
        "./*.js": "./src/*.ts",
        "./*.jsx": "./src/*.tsx",
        "./*.vue": "./src/*.vue"
    },
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "files": [
        "src"
    ],
    "scripts": {
        "typecheck": "tsc --noEmit --project tsconfig.check.json",
        "lint": "prettier ./src --write && bun typecheck && eslint . --fix --cache"
    },
    "dependencies": {
        "@nzyme/types": "0.14.0",
        "@nzyme/vue-utils": "0.14.0",
        "vue": "3.5.28"
    },
    "devDependencies": {
        "@nzyme/eslint": "0.14.0",
        "@nzyme/tsconfig": "0.14.0",
        "@types/node": "25.2.3",
        "eslint": "9.39.2",
        "prettier": "3.8.1",
        "typescript": "5.9.3",
        "vite": "7.3.1"
    },
    "publishConfig": {
        "access": "public"
    }
}
