{
    "name": "@nzyme/vitest",
    "version": "0.14.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/kedrzu/nzyme.git"
    },
    "license": "MIT",
    "author": "Michał Kędrzyński <m.kedrzynski@gmail.com>",
    "sideEffects": false,
    "type": "module",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        },
        "./setup": {
            "import": "./dist/setup.js",
            "types": "./dist/setup.d.ts"
        },
        "./*.js": {
            "types": "./dist/*.d.ts",
            "import": "./dist/*.js",
            "default": "./dist/*.js",
            "source": "./src/*.ts"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build:esm": "tsc --build ./tsconfig.esm.json",
        "typecheck": "tsc --noEmit --project tsconfig.check.json",
        "lint": "prettier ./src --write && yarn typecheck && eslint . --fix --cache"
    },
    "dependencies": {
        "@vitest/expect": "4.0.18",
        "date-fns": "^4.1.0",
        "vitest": "^4.0.18"
    },
    "devDependencies": {
        "@nzyme/eslint": "^0.14.0",
        "@nzyme/tsconfig": "^0.14.0",
        "eslint": "^9.39.2",
        "prettier": "^3.8.1",
        "typescript": "^5.9.3"
    },
    "publishConfig": {
        "access": "public"
    }
}
