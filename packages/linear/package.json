{
    "name": "@nzyme/linear",
    "version": "0.15.1",
    "private": true,
    "description": "Linear API client and CLI commands",
    "license": "MIT",
    "author": "Michał Kędrzyński <m.kedrzynski@gmail.com>",
    "repository": {
        "type": "git",
        "url": "https://github.com/kedrzu/nzyme.git"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "sideEffects": false,
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "source": "./src/index.ts",
            "default": "./dist/index.js"
        },
        "./*.js": {
            "types": "./dist/*.d.ts",
            "source": "./src/*.ts",
            "import": "./dist/*.js",
            "default": "./dist/*.js"
        },
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "schema": "bun run scripts/fetchSchema.ts"
    },
    "dependencies": {
        "@linear/sdk": "101.1.0",
        "@nzyme/cli-core": "workspace:*",
        "@nzyme/github-cli": "workspace:*",
        "@nzyme/logging": "workspace:*",
        "@nzyme/utils": "workspace:*",
        "chalk": "6.0.1",
        "enquirer": "2.4.1",
        "graphql": "17.1.0",
        "open": "11.0.4"
    },
    "devDependencies": {
        "@nzyme/ioc": "workspace:*",
        "@nzyme/tsconfig": "workspace:*",
        "@types/bun": "^1.4.4",
        "@typescript/native-preview": "^7.0.0-dev.20260707.2",
        "clipanion": "^4.0.0-rc.4",
        "oxfmt": "0.77.0"
    },
    "depcheck": {
        "ignoreDeps": [
            "typescript"
        ]
    }
}
