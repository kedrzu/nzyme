{
    "private": true,
    "license": "MIT",
    "author": "Michał Kędrzyński <m.kedrzynski@gmail.com>",
    "repository": {
        "type": "git",
        "url": "https://github.com/kedrzu/nzyme.git"
    },
    "workspaces": [
        "packages/*"
    ],
    "type": "module",
    "scripts": {
        "build": "nx run-many -t build",
        "clean": "del \"**/dist\" \"**/dist-cjs\" \"**/.nx\" \"**/.nzyme\" \"**/.tsbuildinfo\" \"**/*.tsbuildinfo\" \"**/.rollup.cache\" \"!**/node_modules/**\"",
        "clean:npm": "del \"**/node_modules\"",
        "coverage": "bun test --coverage ./packages/*/src",
        "dev": "bun && bun monorepo && bun watch",
        "format": "oxfmt . > /dev/null",
        "format:check": "oxfmt --check .",
        "index": "nzyme index",
        "lint": "oxlint --type-aware --quiet --fix . && eslint --fix .",
        "lint:check": "oxlint --type-aware --quiet . && eslint .",
        "lint:warnings": "oxlint --type-aware .",
        "localise": "nzyme localise",
        "monorepo": "nzyme monorepo",
        "reinstall": "bun run clean && bun run clean:npm && bun install && bun run setup",
        "setup": "zsh setup.sh",
        "test": "bun test ./packages/*/src ./scripts",
        "test:components": "nx run-many -t test:components",
        "typecheck": "tsgo --build && tsgo -p scripts",
        "update": "bun update -i -r --latest",
        "watch": "tsgo --build --watch"
    },
    "dependencies": {
        "tslib": "2.9.1"
    },
    "devDependencies": {
        "@nx/js": "^24.0.5",
        "@nzyme/cli": "workspace:*",
        "@nzyme/eslint": "workspace:*",
        "@nzyme/tsconfig": "workspace:*",
        "@swc-node/register": "1.12.1",
        "@swc/core": "1.16.22",
        "@types/bun": "1.4.4",
        "@types/node": "^26.6.6",
        "@typescript/native-preview": "^7.0.0-dev.20260707.2",
        "del-cli": "8.0.1",
        "eslint": "10.14.0",
        "eslint-plugin-package-json": "1.14.0",
        "nx": "^24.0.5",
        "oxfmt": "0.77.0",
        "oxlint": "1.92.0",
        "oxlint-tsgolint": "7.0.2006"
    },
    "overrides": {
        "@types/bun": "1.4.4"
    },
    "packageManager": "bun@1.4.4",
    "depcheck": {
        "ignoreDeps": [
            "*"
        ]
    },
    "nzyme": {
        "index": {
            "globalUtilPackages": [
                "@nzyme/crypto",
                "@nzyme/dom-utils",
                "@nzyme/fetch-utils",
                "@nzyme/i18n",
                "@nzyme/money",
                "@nzyme/node-utils",
                "@nzyme/utils",
                "@nzyme/validation",
                "@nzyme/xml-utils"
            ]
        }
    },
    "patchedDependencies": {
        "bun-types@1.4.4": "patches/bun-types@1.4.4.patch"
    }
}
