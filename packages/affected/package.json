{
    "name": "@nzyme/affected",
    "version": "0.15.1",
    "description": "Test selection from recorded execution traces: file fingerprints, variants and the affected-test query",
    "license": "MIT",
    "author": "Michał Kędrzyński <m.kedrzynski@gmail.com>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/kedrzu/nzyme.git"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "sideEffects": false,
    "exports": {
        "./*.js": {
            "types": "./dist/*.d.ts",
            "source": "./src/*.ts",
            "import": "./dist/*.js",
            "default": "./dist/*.js"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsgo --build tsconfig.esm.json",
        "format": "oxfmt ./src > /dev/null"
    },
    "dependencies": {
        "@nzyme/crypto": "workspace:*",
        "@nzyme/project-utils": "workspace:*",
        "@nzyme/utils": "workspace:*",
        "@nzyme/xml-utils": "workspace:*",
        "@vue/compiler-sfc": "^3.5.44",
        "hash-wasm": "^4.12.0",
        "oxc-parser": "^0.152.0"
    },
    "devDependencies": {
        "@nzyme/tsconfig": "workspace:*",
        "@types/bun": "^1.4.4",
        "@types/node": "26.6.6",
        "@typescript/native-preview": "^7.0.0-dev.20260707.2",
        "oxfmt": "0.79.0"
    }
}
