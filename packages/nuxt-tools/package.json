{
    "name": "@nzyme/nuxt-tools",
    "version": "0.14.0",
    "description": "Nuxt build tools and modules",
    "license": "MIT",
    "author": "Michał Kędrzyński <m.kedrzynski@gmail.com>",
    "repository": {
        "type": "git",
        "url": "https://github.com/kedrzu/nzyme.git"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "default": "./dist/index.js",
            "types": "./dist/index.d.ts"
        },
        "./*.js": {
            "types": "./dist/*.d.ts",
            "import": "./dist/*.js",
            "source": "./src/*.ts",
            "default": "./dist/*.js"
        }
    },
    "scripts": {
        "build": "tsgo --build tsconfig.esm.json",
        "format": "oxfmt ./src > /dev/null"
    },
    "dependencies": {
        "@types/fs-extra": "11.0.4",
        "@types/mime-types": "3.0.1",
        "fs-extra": "11.4.0",
        "mime-types": "3.0.2",
        "nuxt": "4.4.8",
        "vite": "7.3.6"
    },
    "devDependencies": {
        "@nzyme/tsconfig": "0.14.0",
        "@typescript/native-preview": "^7.0.0-dev.20260707.2",
        "oxfmt": "0.62.0"
    }
}
