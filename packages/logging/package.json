{
    "name": "@nzyme/logging",
    "version": "0.14.0",
    "description": "Structured logging framework",
    "license": "MIT",
    "author": "Michał Kędrzyński <m.kedrzynski@gmail.com>",
    "repository": {
        "type": "git",
        "url": "https://github.com/kedrzu/nzyme.git"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "sideEffects": false,
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./*.js": {
            "types": "./dist/*.d.ts",
            "import": "./dist/*.js",
            "source": "./src/*.ts",
            "default": "./dist/*.js"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsgo --build tsconfig.esm.json",
        "format": "oxfmt ./src > /dev/null"
    },
    "dependencies": {
        "@nzyme/ioc": "0.14.0",
        "@nzyme/types": "0.14.0",
        "@nzyme/utils": "0.14.0",
        "chalk": "5.6.2",
        "cli-highlight": "2.1.11"
    },
    "devDependencies": {
        "@nzyme/eslint": "0.14.0",
        "@nzyme/tsconfig": "0.14.0",
        "@types/node": "26.1.2",
        "@typescript/native-preview": "^7.0.0-dev.20260707.2",
        "eslint": "10.8.0",
        "oxfmt": "0.59.0"
    },
    "nzyme": {
        "cjs": true
    }
}
