{
    "name": "@nzyme/vitest",
    "version": "0.15.1",
    "description": "Vitest configuration and helpers",
    "license": "MIT",
    "author": "Michał Kędrzyński <m.kedrzynski@gmail.com>",
    "repository": {
        "type": "git",
        "url": "https://github.com/kedrzu/nzyme.git"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        },
        "./setup": {
            "import": "./dist/setup.js",
            "types": "./dist/setup.d.ts"
        },
        "./*.js": {
            "types": "./dist/*.d.ts",
            "import": "./dist/*.js",
            "source": "./src/*.ts",
            "default": "./dist/*.js"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsgo --build tsconfig.esm.json",
        "typecheck": "tsgo --noEmit --project tsconfig.check.json",
        "format": "oxfmt ./src > /dev/null"
    },
    "dependencies": {
        "date-fns": "^4.4.0"
    },
    "devDependencies": {
        "@nzyme/tsconfig": "workspace:*",
        "@typescript/native-preview": "^7.0.0-dev.20260707.2",
        "@vitest/expect": "^4.1.10",
        "oxfmt": "0.73.0",
        "vitest": "^4.1.10"
    },
    "peerDependencies": {
        "@vitest/expect": "^4.1.10",
        "vitest": "^4.1.10"
    }
}
