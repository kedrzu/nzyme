{
    "private": true,
    "repository": {
        "type": "git",
        "url": "https://github.com/kedrzu/nzyme.git"
    },
    "license": "MIT",
    "author": "Michał Kędrzyński <m.kedrzynski@gmail.com>",
    "type": "module",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "build": "yarn build:esm && yarn build:cjs",
        "build:esm": "tsc --build",
        "build:cjs": "nzyme build cjs",
        "build:turbo": "turbo run build:esm build:cjs",
        "clean": "del \"**/dist\" \"**/dist-cjs\" \"**/.turbo\" \"**/.tsbuildinfo\" \"**/*.tsbuildinfo\" \"!**/node_modules/**\"",
        "coverage": "vitest run --coverage",
        "dev": "yarn && yarn monorepo && yarn watch",
        "groundup": "yarn && yarn clean &&yarn setup && yarn build",
        "monorepo": "nzyme monorepo",
        "release": "nx release --yes",
        "setup": "turbo run build:esm --filter=@nzyme/cli && yarn monorepo",
        "test": "vitest run",
        "update": "yarn upgrade-interactive",
        "update:self": "yarn set version berry",
        "watch": "tsc --build --watch"
    },
    "dependencies": {
        "tslib": "2.8.1"
    },
    "devDependencies": {
        "@nx/js": "21.2.1",
        "@nzyme/cli": "0.14.0",
        "@swc-node/register": "1.10.10",
        "@swc/core": "1.12.6",
        "del-cli": "6.0.0",
        "eslint": "9.29.0",
        "nx": "21.1.3",
        "prettier": "3.5.3",
        "turbo": "2.5.4",
        "typescript": "5.8.3",
        "vitest": "3.2.4"
    },
    "packageManager": "bun@1.2.4",
    "depcheck": {
        "ignoreDeps": [
            "*"
        ]
    }
}
