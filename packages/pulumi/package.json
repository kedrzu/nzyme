{
    "name": "@nzyme/pulumi",
    "version": "0.14.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/kedrzu/nzyme.git"
    },
    "license": "MIT",
    "author": "Michał Kędrzyński <m.kedrzynski@gmail.com>",
    "sideEffects": false,
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./aws": {
            "types": "./dist/aws.d.ts",
            "default": "./dist/aws.js"
        },
        "./cli": {
            "types": "./dist/cli.d.ts",
            "default": "./dist/cli.js"
        },
        "./*.js": {
            "types": "./dist/*.d.ts",
            "import": "./dist/*.js",
            "source": "./src/*.ts",
            "default": "./dist/*.js"
        }
    },
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc --build tsconfig.esm.json",
        "lint": "prettier ./src --write > /dev/null && eslint . --fix --cache"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "3.1001.0",
        "@aws-sdk/credential-provider-node": "3.972.15",
        "@babel/core": "7.29.0",
        "@babel/plugin-syntax-import-attributes": "7.28.6",
        "@babel/preset-env": "7.29.0",
        "@nzyme/cli": "0.14.0",
        "@nzyme/esm": "0.14.0",
        "@nzyme/ioc": "0.14.0",
        "@nzyme/logging": "0.14.0",
        "@nzyme/rollup-utils": "0.14.0",
        "@nzyme/types": "0.14.0",
        "@nzyme/utils": "0.14.0",
        "@pulumi/aws": "7.21.0",
        "@pulumi/pulumi": "3.225.0",
        "@pulumi/random": "4.19.1",
        "@rollup/plugin-babel": "6.1.0",
        "@rollup/plugin-commonjs": "29.0.0",
        "@rollup/plugin-json": "6.1.0",
        "@rollup/plugin-node-resolve": "16.0.3",
        "@rollup/plugin-replace": "6.0.3",
        "@types/fs-extra": "11.0.4",
        "chalk": "5.6.2",
        "cli-table3": "0.6.5",
        "execa": "9.6.1",
        "fs-extra": "11.3.4",
        "rollup": "4.57.1",
        "rollup-plugin-bundle-stats": "4.21.7",
        "rollup-plugin-sourcemaps": "0.6.3",
        "rollup-plugin-terser": "7.0.2",
        "terser": "5.46.0"
    },
    "devDependencies": {
        "@nzyme/eslint": "0.14.0",
        "@nzyme/tsconfig": "0.14.0",
        "@types/node": "25.3.3",
        "eslint": "9.39.2",
        "prettier": "3.8.1",
        "typescript": "5.9.3"
    },
    "publishConfig": {
        "access": "public"
    },
    "depcheck": {
        "ignoreDeps": [
            "@babel/*"
        ]
    }
}
