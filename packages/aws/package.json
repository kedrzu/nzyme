{
    "name": "@nzyme/aws",
    "version": "0.14.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/kedrzu/nzyme.git"
    },
    "license": "MIT",
    "author": "Michał Kędrzyński <m.kedrzynski@gmail.com>",
    "sideEffects": false,
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./*": {
            "types": "./dist/*.d.ts",
            "default": "./dist/*.js"
        }
    },
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "lint": "eslint . --fix --cache"
    },
    "dependencies": {
        "@aws-sdk/client-cloudfront": "^3.846.0",
        "@aws-sdk/client-dynamodb": "^3.846.0",
        "@aws-sdk/client-s3": "^3.846.0",
        "@aws-sdk/client-sqs": "^3.846.0",
        "@nzyme/fetch-utils": "^0.14.0",
        "@nzyme/ioc": "^0.14.0",
        "@nzyme/logging": "^0.14.0",
        "@nzyme/rpc": "^0.14.0",
        "@nzyme/utils": "^0.14.0",
        "@types/aws-lambda": "^8.10.150",
        "@types/mime-types": "^3.0.1",
        "chalk": "^5.4.1",
        "mime-types": "^3.0.1",
        "s3-sync-client": "^4.3.1",
        "ufo": "^1.6.1"
    },
    "devDependencies": {
        "@nzyme/eslint": "^0.14.0",
        "@nzyme/tsconfig": "^0.14.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "depcheck": {
        "ignoreDeps": [
            "aws-lambda"
        ]
    }
}
