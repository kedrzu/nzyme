{
    "name": "@nzyme/typography",
    "version": "0.14.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/kedrzu/nzyme.git"
    },
    "license": "MIT",
    "author": "Michał Kędrzyński <m.kedrzynski@gmail.com>",
    "sideEffects": false,
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./*.js": {
            "types": "./dist/*.d.ts",
            "import": "./dist/*.js",
            "default": "./dist/*.js",
            "source": "./src/*.ts"
        }
    },
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build:cjs": "tsc --build ./tsconfig.cjs.json",
        "build:esm": "tsc --build ./tsconfig.esm.json",
        "typecheck": "tsc --noEmit --project tsconfig.check.json",
        "lint": "prettier ./src --write && bun typecheck && eslint . --fix --cache"
    },
    "dependencies": {
        "@types/mdast": "4.0.4",
        "mdast-util-newline-to-break": "2.0.0",
        "remark": "15.0.1",
        "remark-behead": "3.1.0",
        "remark-directive": "4.0.0",
        "unified": "11.0.5",
        "unist-util-visit": "5.1.0"
    },
    "devDependencies": {
        "@nzyme/eslint": "0.14.0",
        "@nzyme/tsconfig": "0.14.0",
        "eslint": "9.39.2",
        "prettier": "3.8.1",
        "typescript": "5.9.3",
        "vitest": "4.0.18"
    },
    "publishConfig": {
        "access": "public"
    },
    "nzyme": {
        "cjs": true
    }
}
