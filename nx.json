{
    "$schema": "./node_modules/nx/schemas/nx-schema.json",
    "parallel": 5,
    "tui": {
        "enabled": false
    },
    "plugins": [
        {
            "plugin": "@nx/eslint/plugin",
            "options": {
                "targetName": "lint"
            },
            "include": ["packages/**/*"],
            "exclude": ["packages/github-cli/**/*", "packages/linear/**/*", "packages/sentry-cli/**/*"]
        }
    ],
    "namedInputs": {
        "default": ["{projectRoot}/**/*", "sharedGlobals"],
        "sharedGlobals": [
            "{workspaceRoot}/package.json",
            "{workspaceRoot}/bun.lock",
            "{workspaceRoot}/nx.json",
            "{workspaceRoot}/tsconfig.json"
        ],
        "production": [
            "default",
            "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?",
            "!{projectRoot}/**/__snapshots__/**",
            "!{projectRoot}/**/*.snap"
        ],
        "localEnvironment": [
            {
                "env": "ENV"
            },
            "{workspaceRoot}/.worktree"
        ]
    },
    "targetDefaults": {
        "build": {
            "cache": true,
            "inputs": ["production", "^production", "localEnvironment"],
            "outputs": [
                "{projectRoot}/dist",
                "{projectRoot}/dist-cjs",
                "{projectRoot}/.output",
                "{projectRoot}/storybook-static",
                "{projectRoot}/*.tsbuildinfo"
            ],
            "dependsOn": ["^build"]
        },
        "prep": {
            "cache": true,
            "inputs": ["default", "^default", "localEnvironment"],
            "outputs": ["{projectRoot}/.nuxt"]
        },
        "typecheck": {
            "cache": true,
            "inputs": ["default", "^default", "localEnvironment"],
            "dependsOn": ["prep"]
        },
        "lint": {
            "cache": true,
            "inputs": [
                "default",
                "^default",
                "{workspaceRoot}/packages/tsconfig/**/*",
                "{workspaceRoot}/tools/eslint-rules/**/*",
                {
                    "runtime": "eslint --version"
                }
            ],
            "options": {
                "cache": true
            }
        },
        "test:stories": {
            "cache": true,
            "inputs": ["default", "^default", "localEnvironment"]
        },
        "dev": {
            "cache": false,
            "continuous": true
        },
        "watch": {
            "cache": false,
            "continuous": true
        }
    },
    "release": {
        "projects": ["packages/*"],
        "releaseTag": {
            "pattern": "v{version}"
        },
        "version": {
            "conventionalCommits": true
        },
        "changelog": {
            "workspaceChangelog": {
                "createRelease": "github"
            }
        },
        "git": {
            "commitMessage": "chore: release v{version}"
        }
    },
    "defaultBase": "main"
}
