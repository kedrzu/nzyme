{
    "name": "@nzyme/pulumi",
    "version": "0.14.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/kedrzu/nzyme.git"
    },
    "license": "MIT",
    "author": "Michał Kędrzyński <m.kedrzynski@gmail.com>",
    "sideEffects": false,
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./aws": {
            "types": "./dist/aws.d.ts",
            "default": "./dist/aws.js"
        },
        "./cli": {
            "types": "./dist/cli.d.ts",
            "default": "./dist/cli.js"
        }
    },
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "lint": "eslint . --fix --cache"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.916.0",
        "@aws-sdk/credential-provider-node": "^3.916.0",
        "@babel/core": "^7.28.4",
        "@babel/plugin-syntax-import-attributes": "^7.27.1",
        "@babel/preset-env": "^7.28.3",
        "@nzyme/cli": "^0.14.0",
        "@nzyme/esm": "0.14.0",
        "@nzyme/ioc": "^0.14.0",
        "@nzyme/logging": "^0.14.0",
        "@nzyme/rollup-utils": "0.14.0",
        "@nzyme/types": "^0.14.0",
        "@nzyme/utils": "^0.14.0",
        "@pulumi/aws": "^7.8.0",
        "@pulumi/pulumi": "^3.202.0",
        "@pulumi/random": "^4.18.3",
        "@rollup/plugin-babel": "^6.0.4",
        "@rollup/plugin-commonjs": "^28.0.6",
        "@rollup/plugin-json": "^6.1.0",
        "@rollup/plugin-node-resolve": "^16.0.1",
        "@rollup/plugin-replace": "^6.0.2",
        "@types/fs-extra": "^11.0.4",
        "chalk": "^5.6.2",
        "execa": "^9.6.0",
        "fs-extra": "^11.3.2",
        "rollup": "^4.46.2",
        "rollup-plugin-bundle-stats": "^4.21.1",
        "rollup-plugin-sourcemaps": "^0.6.3",
        "rollup-plugin-terser": "^7.0.2",
        "terser": "^5.44.0"
    },
    "devDependencies": {
        "@nzyme/eslint": "^0.14.0",
        "@nzyme/tsconfig": "^0.14.0",
        "@types/node": "^24.9.1",
        "typescript": "^5.9.3"
    },
    "publishConfig": {
        "access": "public"
    },
    "depcheck": {
        "ignoreDeps": [
            "@babel/*"
        ]
