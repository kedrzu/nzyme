{
    "name": "@nzyme/validation",
    "version": "0.15.1",
    "description": "Validation helpers",
    "license": "MIT",
    "author": "Michał Kędrzyński <m.kedrzynski@gmail.com>",
    "repository": {
        "type": "git",
        "url": "https://github.com/kedrzu/nzyme.git"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "sideEffects": false,
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "source": "./src/index.ts",
            "default": "./dist/index.js"
        },
        "./*.js": {
            "types": "./dist/*.d.ts",
            "source": "./src/*.ts",
            "import": "./dist/*.js",
            "default": "./dist/*.js"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsgo --build tsconfig.esm.json",
        "format": "oxfmt ./src > /dev/null"
    },
    "dependencies": {
        "@nzyme/i18n": "workspace:*",
        "@nzyme/i18n-core": "workspace:*",
        "@nzyme/ioc": "workspace:*",
        "@nzyme/utils": "workspace:*",
        "libphonenumber-js": "1.13.15",
        "postal-codes-js": "2.5.2",
        "vitest": "4.1.10"
    },
    "devDependencies": {
        "@nzyme/tsconfig": "workspace:*",
        "@typescript/native-preview": "^7.0.0-dev.20260707.2",
        "oxfmt": "0.73.0"
    },
    "nzyme": {
        "cjs": true
    }
}
