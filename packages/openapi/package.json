{
    "name": "@nzyme/openapi",
    "version": "0.14.0",
    "description": "Typed fetch client utilities for OpenAPI schemas",
    "license": "MIT",
    "author": "Michał Kędrzyński <m.kedrzynski@gmail.com>",
    "repository": {
        "type": "git",
        "url": "https://github.com/kedrzu/nzyme.git"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "sideEffects": false,
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./*.js": {
            "types": "./dist/*.d.ts",
            "import": "./dist/*.js",
            "source": "./src/*.ts",
            "default": "./dist/*.js"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "schema": "openapi-typescript https://petstore3.swagger.io/api/v3/openapi.json -o ./tests/schema.d.ts",
        "build": "tsgo --build tsconfig.esm.json",
        "format": "oxfmt ./src > /dev/null"
    },
    "dependencies": {
        "@nzyme/fetch-utils": "0.14.0",
        "@nzyme/types": "0.14.0",
        "@nzyme/utils": "0.14.0",
        "ufo": "1.6.4",
        "undici-types": "8.10.0"
    },
    "devDependencies": {
        "@nzyme/eslint": "0.14.0",
        "@nzyme/tsconfig": "0.14.0",
        "@types/bun": "^1.3.13",
        "@typescript/native-preview": "^7.0.0-dev.20260707.2",
        "eslint": "10.8.0",
        "openapi-typescript": "7.13.0",
        "oxfmt": "0.59.0"
    },
    "depcheck": {
        "ignoreDeps": [
            "openapi-typescript"
        ]
    },
    "nzyme": {
        "cjs": true
    }
}
