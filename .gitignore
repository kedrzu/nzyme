
# Dependency directories
node_modules/
dist/
dist-cjs/
.DS_Store

# TypeScript cache
*.tsbuildinfo

# Eslint cache
.eslintcache

.env
.env.*
!.env.example
.nzyme

.nx/cache
.nx/workspace-data

# Agent scratch space: command logs, specs, plans, reviews
.context/

# these are generated by nzyme
tsconfig.json
tsconfig.cjs.json
# …except the hand-written ones covering scripts outside a package `src`
!packages/*/scripts/tsconfig.json
!/scripts/tsconfig.json
*.loc.ts

# Code index — generated by `bun run index` (per-worktree, regenerable). The per-package files are
# listed here, not only in a parent repo's .gitignore, because one can't reach inside this submodule.
/INDEX.md
/UTILS.md
/packages/*/INDEX.md

# Agent worktrees
.claude/worktrees/
