{
    "name": "@nzyme/aws",
    "version": "0.14.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/kedrzu/nzyme.git"
    },
    "license": "MIT",
    "author": "Michał Kędrzyński <m.kedrzynski@gmail.com>",
    "sideEffects": false,
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./*.js": {
            "types": "./dist/*.d.ts",
            "import": "./dist/*.js",
            "source": "./src/*.ts",
            "default": "./dist/*.js"
        }
    },
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc --build tsconfig.esm.json",
        "lint": "prettier ./src --write > /dev/null && eslint . --fix --cache"
    },
    "dependencies": {
        "@aws-sdk/client-cloudfront": "3.1001.0",
        "@aws-sdk/client-dynamodb": "3.1001.0",
        "@aws-sdk/client-s3": "3.1001.0",
        "@aws-sdk/client-sqs": "3.1001.0",
        "@nzyme/fetch-utils": "0.14.0",
        "@nzyme/ioc": "0.14.0",
        "@nzyme/logging": "0.14.0",
        "@nzyme/rpc": "0.14.0",
        "@nzyme/utils": "0.14.0",
        "@types/aws-lambda": "8.10.161",
        "@types/mime-types": "3.0.1",
        "chalk": "5.6.2",
        "mime-types": "3.0.2",
        "s3-sync-client": "4.3.1",
        "ufo": "1.6.3"
    },
    "devDependencies": {
        "@nzyme/eslint": "0.14.0",
        "@nzyme/tsconfig": "0.14.0",
        "eslint": "9.39.2",
        "prettier": "3.8.1",
        "typescript": "5.9.3"
    },
    "publishConfig": {
        "access": "public"
    },
    "depcheck": {
        "ignoreDeps": [
            "aws-lambda"
        ]
    }
}
