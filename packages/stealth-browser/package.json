{
    "name": "@nzyme/stealth-browser",
    "version": "0.16.0",
    "description": "A stealth Chrome over CDP for AI agents: launch, proxy, CLI",
    "license": "MIT",
    "author": "Michał Kędrzyński <m.kedrzynski@gmail.com>",
    "repository": {
        "type": "git",
        "url": "https://github.com/kedrzu/nzyme.git"
    },
    "bin": {
        "stealth-browser": "bin/stealth-browser.js"
    },
    "files": [
        "dist",
        "bin"
    ],
    "type": "module",
    "sideEffects": false,
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "source": "./src/index.ts",
            "default": "./dist/index.js"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsgo --build tsconfig.esm.json",
        "format": "oxfmt ./src > /dev/null"
    },
    "dependencies": {
        "@nzyme/ioc": "workspace:*",
        "@nzyme/logging": "workspace:*",
        "@nzyme/utils": "workspace:*"
    },
    "devDependencies": {
        "@nzyme/tsconfig": "workspace:*",
        "@types/node": "26.6.6",
        "@typescript/native-preview": "^7.0.0-dev.20260707.2",
        "oxfmt": "0.77.0",
        "playwright": "^1.64.1"
    }
}
