{
    "$schema": "https://turbo.build/schema.json",
    "extends": ["//"],
    "tasks": {
        "build:esm": {
            "cache": true,
            "outputs": ["dist/**"],
            "dependsOn": ["^build:esm"]
        },
        "build:cjs": {
            "cache": true,
            "outputs": ["dist/cjs/**"],
            "dependsOn": ["^build:cjs"]
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "watch": {
            "cache": false,
            "persistent": true
        },
        "smoke:cjs": {
            "cache": false,
            "persistent": false
        },
        "smoke:mjs": {
            "cache": false,
            "persistent": false
        }
    },
    "ui": "stream"
}
