{
    "name": "@nzyme/rollup-utils",
    "version": "0.14.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/kedrzu/nzyme.git"
    },
    "license": "MIT",
    "author": "Michał Kędrzyński <m.kedrzynski@gmail.com>",
    "sideEffects": false,
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./*.js": {
            "types": "./dist/*.d.ts",
            "import": "./dist/*.js",
            "default": "./dist/*.js",
            "source": "./src/*.ts"
        }
    },
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build:esm": "tsc --build ./tsconfig.esm.json",
        "typecheck": "tsc --noEmit --project tsconfig.check.json",
        "lint": "prettier ./src --write && yarn typecheck && eslint . --fix --cache"
    },
    "dependencies": {
        "@nzyme/esm": "0.14.0",
        "@nzyme/utils": "0.14.0",
        "@rollup/plugin-commonjs": "29.0.0",
        "@rollup/plugin-json": "6.1.0",
        "@rollup/plugin-node-resolve": "16.0.3",
        "@rollup/plugin-typescript": "12.3.0",
        "@types/fs-extra": "11.0.4",
        "@vitejs/plugin-vue": "6.0.4",
        "@vitejs/plugin-vue-jsx": "5.1.4",
        "chalk": "5.6.2",
        "connect": "3.7.0",
        "fs-extra": "11.3.3",
        "get-port": "7.1.0",
        "http-proxy-middleware": "3.0.5",
        "pkg-types": "^2.3.0",
        "rollup": "4.57.1",
        "rollup-plugin-sourcemaps": "0.6.3",
        "source-map-support": "0.5.21",
        "type-fest": "5.4.4",
        "vite": "7.3.1",
        "vite-plugin-checker": "0.12.0",
        "vite-plugin-dts": "4.5.4",
        "vite-plugin-lib-inject-css": "2.2.2",
        "vite-tsconfig-paths": "6.1.1"
    },
    "devDependencies": {
        "@nzyme/eslint": "0.14.0",
        "@nzyme/tsconfig": "0.14.0",
        "@types/connect": "3.4.38",
        "@types/source-map-support": "0.5.10",
        "eslint": "9.39.2",
        "prettier": "3.8.1",
        "typescript": "5.9.3"
    },
    "publishConfig": {
        "access": "public"
    }
}
