{
    "name": "@nzyme/openapi",
    "version": "0.14.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/kedrzu/nzyme.git"
    },
    "license": "MIT",
    "author": "Michał Kędrzyński <m.kedrzynski@gmail.com>",
    "sideEffects": false,
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build:cjs": "tsc --build ./tsconfig.cjs.json",
        "build:esm": "tsc --build ./tsconfig.esm.json",
        "codegen": "openapi-typescript https://petstore3.swagger.io/api/v3/openapi.json -o ./tests/schema.d.ts",
        "lint": "eslint . --fix --cache"
    },
    "dependencies": {
        "@nzyme/fetch-utils": "^0.14.0",
        "@nzyme/types": "^0.14.0",
        "@nzyme/utils": "^0.14.0",
        "ufo": "^1.6.1",
        "undici-types": "7.16.0"
    },
    "devDependencies": {
        "@nzyme/eslint": "^0.14.0",
        "@nzyme/tsconfig": "^0.14.0",
        "eslint": "^9.39.1",
        "openapi-typescript": "^7.10.1",
        "vitest": "^4.0.8"
    },
    "publishConfig": {
        "access": "public"
    },
    "nzyme": {
        "cjs": true
    },
    "depcheck": {
        "ignoreDeps": [
            "openapi-typescript"
        ]
    }
}
