{
    "$schema": "./node_modules/nx/schemas/nx-schema.json",
    "tui": {
        "enabled": false
    },
    "targetDefaults": {
        "build": {
            "cache": true,
            "outputs": ["{projectRoot}/dist"],
            "dependsOn": ["^build"]
        },
        "dev": {
            "cache": false,
            "continuous": true
        },
        "watch": {
            "cache": false,
            "continuous": true
        }
    },
    "release": {
        "projects": ["packages/*"],
        "releaseTag": {
            "pattern": "v{version}"
        },
        "version": {
            "conventionalCommits": true
        },
        "changelog": {
            "workspaceChangelog": {
                "createRelease": "github"
            }
        },
        "git": {
            "commitMessage": "chore: release v{version}"
        }
    },
    "defaultBase": "main"
}
