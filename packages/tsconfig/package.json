{
    "name": "@nzyme/tsconfig",
    "version": "0.14.0",
    "license": "MIT",
    "author": "Michał Kędrzyński <m.kedrzynski@gmail.com>",
    "repository": {
        "type": "git",
        "url": "https://github.com/kedrzu/nzyme.git"
    },
    "files": [
        "*.json"
    ],
    "type": "module",
    "sideEffects": false,
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "typescript-plugin-css-modules": "5.2.0",
        "typescript-vue-plugin": "1.8.27",
        "vite": "7.3.1",
        "vue": "3.5.33"
    },
    "devDependencies": {
        "eslint": "10.4.0",
        "oxfmt": "0.50.0",
        "typescript": "6.0.3"
    },
    "depcheck": {
        "ignoreDeps": [
            "typescript-plugin-css-modules",
            "typescript-vue-plugin",
            "vite",
            "vue"
        ]
    }
}
