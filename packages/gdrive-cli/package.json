{
    "name": "@nzyme/gdrive-cli",
    "version": "0.16.0",
    "description": "Agent-facing Google Drive commands: search, read Docs as Markdown and Sheets as CSV, download, upload, and permission switches, never permanent deletion",
    "license": "MIT",
    "author": "Michał Kędrzyński <m.kedrzynski@gmail.com>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/kedrzu/nzyme.git"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "sideEffects": false,
    "exports": {
        "./*.js": {
            "types": "./dist/*.d.ts",
            "source": "./src/*.ts",
            "import": "./dist/*.js",
            "default": "./dist/*.js"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsgo --build tsconfig.esm.json",
        "format": "oxfmt ./src > /dev/null"
    },
    "dependencies": {
        "@googleapis/drive": "^27.1.0",
        "@nzyme/cli-core": "workspace:*",
        "@nzyme/google-auth": "workspace:*",
        "@nzyme/node-utils": "workspace:*",
        "@nzyme/project-utils": "workspace:*",
        "@nzyme/utils": "workspace:*"
    },
    "devDependencies": {
        "@nzyme/secrets": "workspace:*",
        "@nzyme/tsconfig": "workspace:*",
        "@types/bun": "^1.4.3",
        "@types/node": "26.6.6",
        "@typescript/native-preview": "^7.0.0-dev.20260707.2",
        "clipanion": "^4.0.0-rc.4",
        "oxfmt": "0.77.0"
    }
}
