{
    "name": "@nzyme/pulumi",
    "version": "0.14.0",
    "description": "Pulumi infrastructure-as-code helpers",
    "license": "MIT",
    "author": "Michał Kędrzyński <m.kedrzynski@gmail.com>",
    "repository": {
        "type": "git",
        "url": "https://github.com/kedrzu/nzyme.git"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "sideEffects": false,
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./aws": {
            "types": "./dist/aws.d.ts",
            "default": "./dist/aws.js"
        },
        "./cli": {
            "types": "./dist/cli.d.ts",
            "default": "./dist/cli.js"
        },
        "./*.js": {
            "types": "./dist/*.d.ts",
            "import": "./dist/*.js",
            "source": "./src/*.ts",
            "default": "./dist/*.js"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsgo --build tsconfig.esm.json",
        "format": "oxfmt ./src > /dev/null"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "3.1103.0",
        "@aws-sdk/credential-provider-node": "3.972.78",
        "@babel/core": "8.0.1",
        "@babel/plugin-syntax-import-attributes": "7.29.7",
        "@babel/preset-env": "8.0.2",
        "@nzyme/cli": "0.14.0",
        "@nzyme/esm": "0.14.0",
        "@nzyme/ioc": "0.14.0",
        "@nzyme/logging": "0.14.0",
        "@nzyme/rollup-utils": "0.14.0",
        "@nzyme/types": "0.14.0",
        "@nzyme/utils": "0.14.0",
        "@pulumi/aws": "7.40.0",
        "@pulumi/pulumi": "3.256.0",
        "@pulumi/random": "4.21.1",
        "@rollup/plugin-babel": "7.1.0",
        "@rollup/plugin-commonjs": "29.0.3",
        "@rollup/plugin-json": "6.1.0",
        "@rollup/plugin-node-resolve": "16.0.3",
        "@rollup/plugin-replace": "6.0.3",
        "@types/fs-extra": "11.0.4",
        "chalk": "5.6.2",
        "cli-table3": "0.6.5",
        "execa": "10.0.1",
        "fs-extra": "11.4.0",
        "rollup": "4.62.2",
        "rollup-plugin-bundle-stats": "4.22.2",
        "rollup-plugin-sourcemaps": "0.6.3",
        "rollup-plugin-terser": "7.0.2",
        "terser": "5.49.2"
    },
    "devDependencies": {
        "@nzyme/eslint": "0.14.0",
        "@nzyme/tsconfig": "0.14.0",
        "@types/node": "26.1.2",
        "@typescript/native-preview": "^7.0.0-dev.20260707.2",
        "eslint": "10.8.0",
        "oxfmt": "0.59.0"
    },
    "depcheck": {
        "ignoreDeps": [
            "@babel/*"
        ]
    }
}
