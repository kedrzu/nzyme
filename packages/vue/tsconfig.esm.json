{
    "extends": "@nzyme/tsconfig/vue.json",
    "compilerOptions": {
        "outDir": "./dist",
        "rootDir": "./src",
        "emitDeclarationOnly": true,
        "composite": false,
        "types": ["vue", "vue/jsx", "vite/client", "@types/node", "bun"]
    },
    "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.json", "src/**/*.scss", "src/**/*.vue"],
    "exclude": ["node_modules", "dist"]
}
