{
    "name": "@nzyme/aws",
    "version": "0.14.0",
    "description": "AWS SDK helpers",
    "license": "MIT",
    "author": "Michał Kędrzyński <m.kedrzynski@gmail.com>",
    "repository": {
        "type": "git",
        "url": "https://github.com/kedrzu/nzyme.git"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "sideEffects": false,
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./*.js": {
            "types": "./dist/*.d.ts",
            "import": "./dist/*.js",
            "source": "./src/*.ts",
            "default": "./dist/*.js"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsgo --build tsconfig.esm.json",
        "lint": "eslint . --fix --cache",
        "format": "oxfmt ./src > /dev/null"
    },
    "dependencies": {
        "@aws-sdk/client-cloudfront": "3.1090.0",
        "@aws-sdk/client-dynamodb": "3.1090.0",
        "@aws-sdk/client-s3": "3.1090.0",
        "@aws-sdk/client-sqs": "3.1090.0",
        "@nzyme/fetch-utils": "0.14.0",
        "@nzyme/ioc": "0.14.0",
        "@nzyme/logging": "0.14.0",
        "@nzyme/rpc": "0.14.0",
        "@nzyme/utils": "0.14.0",
        "@types/aws-lambda": "8.10.162",
        "@types/mime-types": "3.0.1",
        "chalk": "5.6.2",
        "mime-types": "3.0.2",
        "s3-sync-client": "4.3.1",
        "ufo": "1.6.4"
    },
    "devDependencies": {
        "@nzyme/eslint": "0.14.0",
        "@nzyme/tsconfig": "0.14.0",
        "@typescript/native-preview": "^7.0.0-dev.20260707.2",
        "eslint": "10.7.0",
        "oxfmt": "0.59.0"
    },
    "depcheck": {
        "ignoreDeps": [
            "aws-lambda"
        ]
    }
}
