{
    "private": true,
    "license": "MIT",
    "author": "Michał Kędrzyński <m.kedrzynski@gmail.com>",
    "repository": {
        "type": "git",
        "url": "https://github.com/kedrzu/nzyme.git"
    },
    "workspaces": [
        "packages/*"
    ],
    "type": "module",
    "scripts": {
        "build": "nx run-many -t build",
        "clean": "del \"**/dist\" \"**/dist-cjs\" \"**/.nx\" \"**/.nzyme\" \"**/.tsbuildinfo\" \"**/*.tsbuildinfo\" \"**/.rollup.cache\" \"!**/node_modules/**\"",
        "clean:npm": "del \"**/node_modules\"",
        "coverage": "bun test --coverage ./packages/*/src",
        "dev": "bun && bun monorepo && bun watch",
        "format": "oxfmt . > /dev/null && bun run format:md",
        "format:check": "oxfmt --check . && bun run format:md:check",
        "format:md": "nzyme format-markdown . --exclude .context --exclude CHANGELOG.md",
        "format:md:check": "nzyme format-markdown --check . --exclude .context --exclude CHANGELOG.md",
        "lint": "oxlint --type-aware --quiet --fix . && eslint --fix .",
        "lint:check": "oxlint --type-aware --quiet . && eslint .",
        "lint:warnings": "oxlint --type-aware .",
        "localise": "nzyme localise",
        "monorepo": "nzyme monorepo",
        "reinstall": "bun run clean && bun run clean:npm && bun install && bun run setup",
        "release": "nx release --yes",
        "setup": "zsh setup.sh",
        "test": "bun test ./packages/*/src",
        "typecheck": "tsgo --build",
        "update": "bun update -i -r --latest",
        "watch": "tsgo --build --watch"
    },
    "dependencies": {
        "tslib": "2.8.1"
    },
    "devDependencies": {
        "@nx/js": "^23.1.0",
        "@nzyme/cli": "0.14.0",
        "@nzyme/eslint": "0.14.0",
        "@swc-node/register": "1.10.10",
        "@swc/core": "1.12.6",
        "@types/bun": "1.4.2",
        "@types/node": "^26.1.1",
        "@typescript/native-preview": "^7.0.0-dev.20260707.2",
        "del-cli": "7.0.0",
        "eslint": "10.12.0",
        "nx": "^23.1.0",
        "oxfmt": "0.71.0",
        "oxlint": "1.86.0",
        "oxlint-tsgolint": "7.0.2003"
    },
    "overrides": {
        "@types/bun": "1.4.2"
    },
    "packageManager": "bun@1.4.2",
    "depcheck": {
        "ignoreDeps": [
            "*"
        ]
    },
    "patchedDependencies": {
        "bun-types@1.4.2": "patches/bun-types@1.4.2.patch"
    }
}
