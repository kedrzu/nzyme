{
    "name": "@nzyme/spotify-cli",
    "version": "0.19.0",
    "description": "Spotify for agents and programs: a typed Web API client, PKCE sign-in with the token in a secret store, and curated commands that never remove anything",
    "license": "MIT",
    "author": "Michał Kędrzyński <m.kedrzynski@gmail.com>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/kedrzu/nzyme.git"
    },
    "files": [
        "dist",
        "openapi.json"
    ],
    "type": "module",
    "sideEffects": false,
    "exports": {
        "./*.js": {
            "types": "./dist/*.d.ts",
            "source": "./src/*.ts",
            "import": "./dist/*.js",
            "default": "./dist/*.js"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsgo --build tsconfig.esm.json",
        "format": "oxfmt ./src > /dev/null",
        "schema": "bun run scripts/fetchSchema.ts && oxfmt openapi.json",
        "codegen": "openapi-typescript openapi.json -o src/schema.gen.ts && oxfmt src/schema.gen.ts"
    },
    "dependencies": {
        "@nzyme/cli-core": "workspace:*",
        "@nzyme/ioc": "workspace:*",
        "@nzyme/logging": "workspace:*",
        "@nzyme/node-utils": "workspace:*",
        "@nzyme/openapi": "workspace:*",
        "@nzyme/openapi-cli": "workspace:*",
        "@nzyme/secrets": "workspace:*",
        "@nzyme/types": "workspace:*"
    },
    "devDependencies": {
        "@nzyme/tsconfig": "workspace:*",
        "@types/bun": "^1.4.5",
        "@types/node": "26.6.6",
        "@typescript/native-preview": "^7.0.0-dev.20260707.2",
        "clipanion": "^4.0.0-rc.4",
        "openapi-typescript": "^7.13.0",
        "oxfmt": "0.79.0"
    }
}
