{
    "name": "@nzyme/logging-ui",
    "private": true,
    "description": "Standalone Nuxt app for viewing and browsing ingested logs",
    "type": "module",
    "scripts": {
        "dev": "nuxt dev",
        "build": "nuxt build"
    },
    "dependencies": {
        "@nuxt/schema": "4.6.0",
        "@nzyme/ioc": "workspace:*",
        "@nzyme/logging": "workspace:*",
        "@nzyme/utils": "workspace:*",
        "@nzyme/vue-ioc": "workspace:*",
        "@nzyme/vue-utils": "workspace:*",
        "@primevue/nuxt-module": "5.0.2",
        "@primevue/themes": "4.5.4",
        "crossws": "0.3.5",
        "dexie": "4.4.6",
        "lucide-vue-next": "1.0.0",
        "nuxt": "4.4.8",
        "primeicons": "8.0.2",
        "primevue": "5.0.2",
        "vue": "3.5.43",
        "vue-json-pretty": "2.6.0",
        "vue-router": "^5.3.1"
    },
    "devDependencies": {
        "oxfmt": "0.71.0",
        "typescript": "6.0.3",
        "vue-tsc": "^3.3.12"
    },
    "depcheck": {
        "ignoreDeps": [
            "#components",
            "#app",
            "#imports"
        ],
        "ignoreFiles": [
            ".output/**"
        ]
    }
}
