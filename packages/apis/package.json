{
    "name": "@nzyme/apis",
    "version": "0.14.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/kedrzu/nzyme.git"
    },
    "license": "MIT",
    "author": "Michał Kędrzyński <m.kedrzynski@gmail.com>",
    "sideEffects": false,
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./*": {
            "types": "./dist/*.d.ts",
            "default": "./dist/*.js"
        }
    },
    "typesVersions": {
        "*": {
            "*": [
                "./dist/*.d.ts"
            ]
        }
    },
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "lint": "eslint . --fix --cache"
    },
    "dependencies": {
        "@nzyme/fetch-utils": "^0.14.0",
        "@nzyme/types": "^0.14.0"
    },
    "devDependencies": {
        "@nzyme/eslint": "^0.14.0",
        "@nzyme/tsconfig": "^0.14.0",
        "typecript": "^0.0.1-security"
    },
    "publishConfig": {
        "access": "public"
    }
}
