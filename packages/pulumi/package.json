{
    "name": "@nzyme/pulumi",
    "version": "0.8.0",
    "sideEffects": false,
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/kedrzu/nzyme.git"
    },
    "author": "Michał Kędrzyński <m.kedrzynski@gmail.com>",
    "type": "module",
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "dist"
    ],
    "main": "./dist/esm/index.js",
    "types": "./dist/esm/index.d.ts",
    "module": "./dist/esm/index.js",
    "exports": {
        ".": {
            "types": "./dist/esm/index.d.ts",
            "default": "./dist/esm/index.js"
        },
        "./*": {
            "types": "./dist/esm/*.d.ts",
            "default": "./dist/esm/*.js"
        }
    },
    "scripts": {
        "eslint": "eslint . --fix --cache"
    },
    "dependencies": {
        "@nzyme/ioc": "^0.8.0",
        "@nzyme/logging": "^0.8.0",
        "@nzyme/project-utils": "^0.8.0",
        "@nzyme/types": "^0.8.0",
        "@nzyme/utils": "^0.8.0",
        "@pulumi/aws": "^6.72.0",
        "@pulumi/pulumi": "^3.156.0",
        "@types/fs-extra": "^11.0.4",
        "execa": "^9.5.2",
        "fs-extra": "^11.3.0",
        "tslib": "^2.8.1"
    },
    "devDependencies": {
        "@nzyme/eslint": "^0.8.0",
        "@nzyme/tsconfig": "^0.8.0",
        "@nzyme/vitest": "^0.8.0",
        "@types/node": "^22.13.10",
        "typescript": "^5.8.2"
    }
}
