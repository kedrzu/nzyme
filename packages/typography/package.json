{
    "name": "@nzyme/typography",
    "version": "0.14.0",
    "description": "Markdown parsing/rendering utilities",
    "license": "MIT",
    "author": "Michał Kędrzyński <m.kedrzynski@gmail.com>",
    "repository": {
        "type": "git",
        "url": "https://github.com/kedrzu/nzyme.git"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "sideEffects": false,
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./*.js": {
            "types": "./dist/*.d.ts",
            "import": "./dist/*.js",
            "source": "./src/*.ts",
            "default": "./dist/*.js"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsgo --build tsconfig.esm.json",
        "lint": "eslint . --fix --cache",
        "format": "oxfmt ./src > /dev/null"
    },
    "dependencies": {
        "@types/mdast": "4.0.4",
        "mdast-util-newline-to-break": "2.0.0",
        "remark": "15.0.1",
        "remark-behead": "3.1.0",
        "remark-directive": "4.0.0",
        "unified": "11.0.5",
        "unist-util-visit": "5.1.0"
    },
    "devDependencies": {
        "@nzyme/eslint": "0.14.0",
        "@nzyme/tsconfig": "0.14.0",
        "@types/bun": "^1.3.13",
        "@typescript/native-preview": "^7.0.0-dev.20260428.1",
        "eslint": "10.4.0",
        "oxfmt": "0.50.0"
    },
    "nzyme": {
        "cjs": true
    }
}
