{
    // Shared rule preset. No repo layout — ignore patterns and per-package overrides describe a
    // particular repo's directories and belong in each repo's root `.oxlintrc.json`. An override
    // keyed on a file KIND (`**/*.d.ts`) is not layout: it holds in any repo, so it lives here.
    //
    // The rule set mirrors what ESLint enforced before the oxlint migration: the `correctness`
    // category covers 57 of those rules, the explicit entries below cover the remaining 38.
    "plugins": ["typescript", "unicorn", "oxc", "import", "promise"],
    "categories": {
        "correctness": "error"
    },
    "rules": {
        "curly": "error",
        // `x == null` is the idiomatic "null or undefined" check and is deliberately kept; without
        // the carve-out the rule reports 375 of them and buries the handful of real loose
        // comparisons.
        "eqeqeq": ["error", "always", { "null": "ignore" }],
        // Mirrors the pre-migration ESLint options: a leading underscore marks a binding as
        // deliberately unused, in every position including catch parameters.
        "no-unused-vars": [
            "error",
            {
                "args": "all",
                "argsIgnorePattern": "^_",
                "caughtErrors": "all",
                "caughtErrorsIgnorePattern": "^_",
                "destructuredArrayIgnorePattern": "^_",
                "varsIgnorePattern": "^_"
            }
        ],
        "no-array-constructor": "error",
        "no-case-declarations": "error",
        "no-empty": "error",
        "no-fallthrough": "error",
        "no-prototype-builtins": "error",
        "no-regex-spaces": "error",
        "no-unexpected-multiline": "error",
        "no-useless-assignment": "error",
        "no-var": "error",
        "prefer-const": "error",
        "prefer-rest-params": "error",
        "prefer-spread": "error",
        "preserve-caught-error": "error",

        "typescript/ban-ts-comment": "error",
        "typescript/consistent-type-imports": "error",
        "typescript/no-empty-object-type": "error",
        "typescript/no-explicit-any": "error",
        "typescript/no-import-type-side-effects": "error",
        "typescript/no-misused-promises": "error",
        "typescript/no-namespace": "error",
        "typescript/no-require-imports": "error",
        "typescript/no-unnecessary-type-assertion": "error",
        "typescript/no-unnecessary-type-constraint": "error",
        "typescript/no-unsafe-argument": "error",
        "typescript/no-unsafe-assignment": "error",
        "typescript/no-unsafe-call": "error",
        "typescript/no-unsafe-enum-comparison": "error",
        "typescript/no-unsafe-function-type": "error",
        "typescript/no-unsafe-member-access": "error",
        "typescript/no-unsafe-return": "error",
        "typescript/only-throw-error": "error",
        "typescript/prefer-promise-reject-errors": "error",
        // The type-aware variant supersedes the base `require-await`, which the typescript-eslint
        // docs prescribe disabling: the base rule cannot see that a function returns a promise
        // without awaiting it, and reports the same locations a second time.
        "typescript/require-await": "error",
        "typescript/restrict-plus-operands": "error",

        // Rules with zero violations in this repo. They cost no fix and from here on they block the
        // class of bug from coming back — a rule that finds nothing is a reason to enable it, not to
        // skip it.
        "typescript/no-duplicate-type-constituents": "error",
        "typescript/no-extraneous-class": "error",
        "typescript/no-mixed-enums": "error",
        "typescript/no-redundant-type-constituents": "error",
        "typescript/prefer-find": "error",
        "unicorn/no-useless-promise-resolve-reject": "error",
        "unicorn/prefer-array-find": "error",

        // Step 2 — findings whose fix has no interpretation to choose. Grouped here while the
        // config is still an explicit list; the final shape moves them under `categories`.
        "no-alert": "error",
        "no-inner-declarations": "error",
        "no-loop-func": "error",
        "no-unmodified-loop-condition": "error",
        "no-unneeded-ternary": "error",
        "no-useless-concat": "error",
        "no-useless-constructor": "error",
        "no-useless-return": "error",
        "radix": "error",
        "symbol-description": "error",

        // Warn, not error: a deprecation is advice about the future, not a defect today, and the
        // replacement often sits in a third-party package on its own schedule. Blocking the build
        // on someone else's `@deprecated` tag would turn an upstream release into our outage.
        "typescript/no-deprecated": "warn",
        "typescript/no-unnecessary-type-arguments": "error",
        "typescript/use-unknown-in-catch-callback-variable": "error",
        "typescript/switch-exhaustiveness-check": ["error", { "considerDefaultExhaustiveForUnions": true }],
        "typescript/no-unnecessary-boolean-literal-compare": "error",
        "typescript/no-unnecessary-template-expression": "error",
        "typescript/no-unnecessary-type-conversion": "error",
        "typescript/non-nullable-type-assertion-style": "error",
        "typescript/prefer-includes": "error",

        "unicorn/consistent-assert": "error",
        "unicorn/no-abusive-eslint-disable": "error",
        "unicorn/no-array-fill-with-reference-type": "error",
        "unicorn/no-hex-escape": "error",
        // `instanceof Function` only holds within one JS realm — it is false for a function that
        // crossed a `node:vm` context, a worker or an iframe. `isFunction` from `@nzyme/utils` is
        // the realm-safe check and narrows a union to its callable members.
        "unicorn/no-instanceof-builtins": "error",
        "unicorn/no-immediate-mutation": "error",
        "unicorn/no-negation-in-equality-check": "error",
        "unicorn/no-unnecessary-array-splice-count": "error",
        "unicorn/no-useless-switch-case": "error",
        "unicorn/prefer-add-event-listener": "error",
        "unicorn/prefer-array-some": "error",
        "unicorn/prefer-code-point": "error",
        "unicorn/prefer-date-now": "error",
        "unicorn/prefer-dom-node-append": "error",
        "unicorn/prefer-dom-node-remove": "error",
        "unicorn/prefer-import-meta-properties": "error",
        "unicorn/prefer-math-min-max": "error",
        "unicorn/prefer-node-protocol": "error",
        "unicorn/prefer-number-properties": "error",
        "unicorn/prefer-type-error": "error",

        "oxc/no-accumulating-spread": "error",
        "oxc/no-map-spread": "error",

        "promise/catch-or-return": "error",
        "promise/no-promise-in-callback": "error",

        "import/no-empty-named-blocks": "error",
        "import/no-named-as-default-member": "error",
        "import/no-self-import": "error",

        "import/consistent-type-specifier-style": "error",
        "import/newline-after-import": "error",
        "import/no-cycle": "error",
        "import/no-duplicates": "error",

        // Its autofix rewrites an array literal into `new Set([...])` with no regard for the
        // runtime. The single finding in this repo was `ALLOWED_ORIGINS` in
        // `packages/file-gateway/src/getFileGatewayCorsOrigin.ts`, which carries a comment stating
        // that the CloudFront Functions `cloudfront-js-2.0` runtime does not expose `Set` and that
        // using one there is a `ReferenceError` at load plus a 503 on every request. A lookup rule
        // that cannot see the target runtime is not worth one micro-optimisation.
        "unicorn/prefer-set-has": "off",

        // Exists for `xs.map(Number)` and `xs.map(parseInt)`, where the index `map` also passes
        // becomes a second argument. All 21 findings here were named single-parameter mappers
        // (`map(deserializeEvent)`, `filter(isReservedOption)`), so the rule only turned readable
        // point-free code into `x => f(x)` noise.
        "unicorn/no-array-reverse": "error",
        "unicorn/no-array-sort": "error",
        "unicorn/no-array-callback-reference": "off",
        // Meant to stop `delete` from destroying a typed object's shape, but it cannot tell that
        // apart from a delete on a genuine dictionary — and every finding here was the latter
        // (`process.env`, `globalThis`, `Record<string, string>` dependency maps). Its suggested
        // `Reflect.deleteProperty` is strictly more obscure for the same effect.
        "typescript/no-dynamic-delete": "off",
        // Rewrites `typeof x === 'undefined'` to `x === undefined`, which throws `ReferenceError`
        // for a global that may not be declared at all. Its only finding was `getCookieBot`, whose
        // whole purpose is to answer whether the Cookiebot script ever loaded.
        "unicorn/no-typeof-undefined": "off",
        // Fires when a default import shares a name with a named export, but does not distinguish a
        // type from a value. `layout/Layout` exports `type Layout` alongside the component default;
        // TypeScript keeps those in separate namespaces, so the only thing the rule bought was
        // renaming `<Layout>` to `<LayoutComponent>` in three templates.
        "import/no-named-as-default": "off",

        // Off, not warn. The rule is right that a type parameter used once in a signature binds
        // nothing — `xmlParse<T>(…) as T` and `ContextProvider.get<T>(key)` hand back whatever the
        // caller asked for with no evidence behind it. But removing the parameter only moves the
        // cast to the call sites; the honest fix gives the generic real evidence (return `unknown`
        // and validate, or take a `ZodType<T>`), and that is an API migration across ~12 functions,
        // not a lint pass. Left off rather than as a permanent warning so the linter keeps meaning
        // "this is yours, now".
        "typescript/no-unnecessary-type-parameters": "off",

        // `dataset` lives on `HTMLElement`, but plenty of DOM code legitimately holds only an
        // `Element` — `IntersectionObserverEntry.target` is typed that way, and the chat event
        // observer reads `data-seq` off it. The rule's rewrite does not compile there, and the
        // guard it would need buys nothing over `getAttribute`.
        "unicorn/prefer-dom-node-dataset": "off",
        // Targets `xs.map(x => ({ ...x, extra }))`, the idiomatic immutable update. Its replacement
        // is less readable for an allocation count that is the same order either way, and none of
        // the seven sites is a hot path (a logger call, two tests, an Effect promise, a computed
        // over search results). `no-accumulating-spread`, which catches the genuinely quadratic
        // `reduce` form, stays on.
        "oxc/no-map-spread": "off",

        // Contradicts `unicorn/no-array-callback-reference`, which we keep: it wants
        // `xs.map(x => String(x))` collapsed to `xs.map(String)`, and that is exactly the form the
        // other rule exists to prevent (the callback also receives the index and the array). The
        // safer of the two wins.
        "unicorn/prefer-native-coercion-functions": "off",

        // Matches any `.postMessage(...)` by name, but the rule is about the browser's
        // `window.postMessage`, where a missing target origin lets any origin read the message.
        // All seven findings are `node:worker_threads` `Worker`/`parentPort.postMessage` (no such
        // parameter exists in that API) and Slack's `chat.postMessage`.
        "unicorn/require-post-message-target-origin": "off",
        // `seed | 0` in `rngMulberry32` wraps into signed 32-bit range, which is the point;
        // `Math.trunc` truncates without wrapping, so the rewrite changes the generator's output
        // for out-of-range seeds.
        "unicorn/prefer-math-trunc": "off",
        // Matches `readAsText` by name. The only finding is `AdmZip`'s own `zip.readAsText()` —
        // no `Blob` and no `FileReader` anywhere near it.
        "unicorn/prefer-blob-reading-methods": "off",
        // Its alternative is the Cookie Store API, which is async and unsupported in Safari and
        // Firefox. `dom-utils`' `setCookie` is a synchronous helper, so the rule has no reachable
        // fix here.
        "unicorn/no-document-cookie": "off",

        // Deletes the empty `export {};` that marks a file as an ESM module rather than a global
        // script, and autofixes it silently. Both findings are that marker: `@nzyme/aws`'s package
        // entry point and the `e2e/endpoints.ts` consumed via `import * as e2eHandlers`. Unlike
        // `import/no-empty-named-blocks` below this one cannot be narrowed to declaration files —
        // both sites are ordinary `.ts`.
        "unicorn/require-module-specifiers": "off",
        // Reports every computed access into a namespace import. That is exactly how generated
        // `.loc` translation modules are consumed (`l[key]`), so the rule is noise here.
        "import/namespace": "off",
        // Fires only on string-array sorts in tests, where the default lexicographic order is the
        // intended one. `ignoreStringArrays` is accepted by the schema but has no effect in
        // oxlint's implementation, so there is no way to keep the numeric-sort protection alone.
        "typescript/require-array-sort-compare": "off"
    },
    "overrides": [
        {
            // A Vue SFC references its own file to pull in the compiled CSS module
            // (`import css from './Button.vue?vue&type=style&…&lang.module.scss'`). That is the
            // documented way to get scoped styles, not the accidental self-reference the rule hunts.
            "files": ["**/*.vue"],
            "rules": { "import/no-self-import": "off", "import/no-cycle": "off" }
        },
        {
            // In a declaration file an empty import is not dead code — it is what makes the file a
            // module, without which its `declare global` block stops augmenting anything. Removing
            // `import type {} from '@nzyme/utils'` from `dom-utils/src/shims.d.ts` silently dropped
            // the `Navigator.userAgentData` augmentation and degraded every consumer to an error
            // type, with no failure to point at. Ordinary source keeps the rule.
            "files": ["**/*.d.ts"],
            "rules": { "import/no-empty-named-blocks": "off" }
        }
    ]
}
