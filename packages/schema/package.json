{
    "name": "@nzyme/schema",
    "version": "0.14.0",
    "description": "Runtime schema + TypeScript AST parsing",
    "license": "MIT",
    "author": "Michał Kędrzyński <m.kedrzynski@gmail.com>",
    "repository": {
        "type": "git",
        "url": "https://github.com/kedrzu/nzyme.git"
    },
    "bin": {
        "zchema": "./dist/cli/cli.js"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "sideEffects": false,
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./*.js": {
            "types": "./dist/*.d.ts",
            "import": "./dist/*.js",
            "source": "./src/*.ts",
            "default": "./dist/*.js"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "lint": "eslint . --fix --cache",
        "format": "oxfmt ./src > /dev/null",
        "test": "vitest run"
    },
    "dependencies": {
        "@nzyme/cli": "0.14.0",
        "@nzyme/project-utils": "0.14.0",
        "@nzyme/utils": "0.14.0",
        "chalk": "5.6.2",
        "chokidar": "5.0.0",
        "fast-glob": "3.3.3",
        "fs-extra": "11.3.6",
        "typescript": "6.0.3",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@nzyme/eslint": "0.14.0",
        "@nzyme/tsconfig": "0.14.0",
        "@types/bun": "^1.3.11",
        "@types/fs-extra": "11.0.4",
        "eslint": "10.7.0",
        "oxfmt": "0.59.0"
    },
    "nzyme": {
        "cjs": true
    }
}
