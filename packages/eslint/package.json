{
    "name": "@nzyme/eslint",
    "version": "0.14.0",
    "description": "Shared ESLint configuration (framework)",
    "license": "MIT",
    "author": "Michał Kędrzyński <m.kedrzynski@gmail.com>",
    "repository": {
        "type": "git",
        "url": "https://github.com/kedrzu/nzyme.git"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        },
        "./*.js": {
            "types": "./dist/*.d.ts",
            "import": "./dist/*.js",
            "source": "./src/*.ts",
            "default": "./dist/*.js"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsgo --build tsconfig.esm.json",
        "lint": "eslint . --fix --cache",
        "format": "oxfmt ./src > /dev/null"
    },
    "dependencies": {
        "@eslint/js": "10.0.1",
        "@typescript-eslint/parser": "8.59.3",
        "eslint": "10.4.0",
        "eslint-plugin-import": "2.32.0",
        "eslint-plugin-jsdoc": "62.9.0",
        "eslint-plugin-package-json": "1.0.0",
        "eslint-plugin-perfectionist": "5.9.0",
        "eslint-plugin-react": "7.37.5",
        "eslint-plugin-vue": "10.9.1",
        "eslint-plugin-workspaces": "0.12.1",
        "globals": "17.6.0",
        "jsonc-eslint-parser": "3.1.0",
        "typescript-eslint": "8.59.3",
        "vue-eslint-parser": "10.4.0"
    },
    "devDependencies": {
        "@nzyme/tsconfig": "0.14.0",
        "@types/node": "^25.5.0",
        "@typescript/native-preview": "^7.0.0-dev.20260428.1",
        "oxfmt": "0.50.0"
    }
}
