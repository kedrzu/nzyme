{
    "name": "@nzyme/cli",
    "version": "0.14.0",
    "license": "MIT",
    "author": "Michał Kędrzyński <m.kedrzynski@gmail.com>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/kedrzu/nzyme.git"
    },
    "bin": {
        "nzyme": "bin/cli.js"
    },
    "files": [
        "dist",
        "bin"
    ],
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./*.js": {
            "types": "./dist/*.d.ts",
            "import": "./dist/*.js",
            "source": "./src/*.ts",
            "default": "./dist/*.js"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsgo --build tsconfig.esm.json",
        "lint": "eslint . --fix --cache",
        "format": "oxfmt ./src > /dev/null"
    },
    "dependencies": {
        "@nzyme/i18n-compiler": "0.14.0",
        "@nzyme/ioc": "0.14.0",
        "@nzyme/logging": "0.14.0",
        "@nzyme/node-utils": "0.14.0",
        "@nzyme/project-utils": "0.14.0",
        "@nzyme/utils": "0.14.0",
        "@types/fs-extra": "11.0.4",
        "chalk": "5.6.2",
        "chokidar": "5.0.0",
        "clipanion": "4.0.0-rc.4",
        "comment-json": "4.6.2",
        "compare-versions": "6.1.1",
        "depcheck": "1.4.7",
        "enquirer": "2.4.1",
        "execa": "9.6.1",
        "fs-extra": "11.3.4",
        "latest-version": "9.0.0",
        "lodash.merge": "4.6.2",
        "source-map-support": "0.5.21",
        "type-fest": "5.5.0"
    },
    "devDependencies": {
        "@nzyme/eslint": "0.14.0",
        "@nzyme/tsconfig": "0.14.0",
        "@types/lodash.merge": "4.6.9",
        "@types/node": "25.5.0",
        "@types/source-map-support": "0.5.10",
        "@typescript/native-preview": "^7.0.0-dev.20260428.1",
        "eslint": "10.1.0",
        "oxfmt": "0.46.0"
    },
    "engines": {
        "node": ">=20"
    }
}
