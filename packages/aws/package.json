{
    "name": "@nzyme/aws",
    "version": "0.14.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/kedrzu/nzyme.git"
    },
    "license": "MIT",
    "author": "Michał Kędrzyński <m.kedrzynski@gmail.com>",
    "sideEffects": false,
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./*": {
            "types": "./dist/*.d.ts",
            "default": "./dist/*.js"
        }
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "lint": "eslint . --fix --cache"
    },
    "dependencies": {
        "@aws-sdk/client-cloudfront": "^3.804.0",
        "@aws-sdk/client-dynamodb": "^3.804.0",
        "@aws-sdk/client-s3": "^3.804.0",
        "@aws-sdk/client-sqs": "^3.804.0",
        "@nzyme/ioc": "^0.14.0",
        "@nzyme/logging": "^0.14.0",
        "@nzyme/types": "^0.14.0",
        "@nzyme/utils": "^0.14.0",
        "@types/aws-lambda": "^8.10.149",
        "@types/mime-types": "^2.1.4",
        "mime-types": "^3.0.1",
        "pino": "^9.6.0",
        "pino-lambda": "^4.4.1",
        "s3-sync-client": "^4.3.1",
        "tslib": "^2.8.1"
    },
    "devDependencies": {
        "@nzyme/eslint": "^0.14.0",
        "@nzyme/tsconfig": "^0.14.0",
        "@nzyme/vitest": "^0.14.0",
        "@types/node": "^22.15.14",
        "eslint": "^9.26.0",
        "typescript": "^5.8.3"
    },
    "publishConfig": {
        "access": "public"
    }
}
