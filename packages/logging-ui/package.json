{
    "name": "@nzyme/logging-ui",
    "private": true,
    "description": "Standalone Nuxt app for viewing and browsing ingested logs",
    "type": "module",
    "scripts": {
        "dev": "nuxt dev",
        "build": "nuxt build"
    },
    "dependencies": {
        "@lucide/vue": "1.61.0",
        "@nuxt/schema": "4.4.8",
        "@nzyme/ioc": "workspace:*",
        "@nzyme/logging": "workspace:*",
        "@nzyme/utils": "workspace:*",
        "@nzyme/vue-ioc": "workspace:*",
        "@nzyme/vue-utils": "workspace:*",
        "@primeuix/themes": "3.0.1",
        "@primevue/nuxt-module": "5.0.2",
        "crossws": "0.3.5",
        "dexie": "4.4.6",
        "nuxt": "4.4.8",
        "primeicons": "8.0.2",
        "primevue": "5.0.2",
        "vue": "3.5.44",
        "vue-json-pretty": "2.6.0",
        "vue-router": "^5.4.0"
    },
    "devDependencies": {
        "oxfmt": "0.73.0",
        "typescript": "6.0.3",
        "vue-tsc": "^3.3.13"
    },
    "depcheck": {
        "ignoreDeps": [
            "#components",
            "#app",
            "#imports"
        ],
        "ignoreFiles": [
            ".output/**"
        ]
    }
}
