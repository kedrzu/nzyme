{
    "name": "@nzyme/eslint",
    "version": "0.14.0",
    "description": "Shared Vue ESLint config and oxlint rule preset (framework)",
    "license": "MIT",
    "author": "Michał Kędrzyński <m.kedrzynski@gmail.com>",
    "repository": {
        "type": "git",
        "url": "https://github.com/kedrzu/nzyme.git"
    },
    "files": [
        "dist",
        "oxlintrc.json"
    ],
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        },
        "./*.js": {
            "types": "./dist/*.d.ts",
            "import": "./dist/*.js",
            "source": "./src/*.ts",
            "default": "./dist/*.js"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsgo --build tsconfig.esm.json",
        "format": "oxfmt ./src > /dev/null"
    },
    "dependencies": {
        "@typescript-eslint/parser": "8.66.0",
        "eslint": "10.8.0",
        "eslint-plugin-vue": "10.10.0",
        "vue-eslint-parser": "10.4.1"
    },
    "devDependencies": {
        "@nzyme/tsconfig": "0.14.0",
        "@types/node": "^26.1.2",
        "@typescript/native-preview": "^7.0.0-dev.20260707.2",
        "oxfmt": "0.62.0"
    }
}
