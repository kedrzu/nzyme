{
    "name": "@nzyme/openapi",
    "version": "0.14.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/kedrzu/nzyme.git"
    },
    "license": "MIT",
    "author": "Michał Kędrzyński <m.kedrzynski@gmail.com>",
    "sideEffects": false,
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./*.js": {
            "types": "./dist/*.d.ts",
            "import": "./dist/*.js",
            "source": "./src/*.ts",
            "default": "./dist/*.js"
        }
    },
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "codegen": "openapi-typescript https://petstore3.swagger.io/api/v3/openapi.json -o ./tests/schema.d.ts",
        "lint": "prettier ./src --write > /dev/null && eslint . --fix --cache"
    },
    "dependencies": {
        "@nzyme/fetch-utils": "0.14.0",
        "@nzyme/types": "0.14.0",
        "@nzyme/utils": "0.14.0",
        "ufo": "1.6.3",
        "undici-types": "7.22.0"
    },
    "devDependencies": {
        "@nzyme/eslint": "0.14.0",
        "@nzyme/tsconfig": "0.14.0",
        "@types/bun": "^1.3.9",
        "eslint": "9.39.2",
        "openapi-typescript": "7.13.0",
        "prettier": "3.8.1",
        "typescript": "5.9.3"
    },
    "publishConfig": {
        "access": "public"
    },
    "nzyme": {
        "cjs": true
    },
    "depcheck": {
        "ignoreDeps": [
            "openapi-typescript"
        ]
    }
}
