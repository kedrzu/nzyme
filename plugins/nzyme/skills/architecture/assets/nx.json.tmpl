{
    "$schema": "./node_modules/nx/schemas/nx-schema.json",
    "defaultBase": "origin/main",
    "parallel": 5,
    "tui": {
        "enabled": true,
        // Exit as soon as tasks finish instead of the default 3s countdown, which renders a
        // per-run performance report in a popup on every multi-task command.
        "autoExit": true
    },
    "namedInputs": {
        "default": ["{projectRoot}/**/*", "sharedGlobals", "submoduleDefault"],
        "sharedGlobals": [
            "{workspaceRoot}/package.json",
            "{workspaceRoot}/bun.lock",
            "{workspaceRoot}/nx.json",
            "{workspaceRoot}/tsconfig.json"
        ],
        // Nx hashes only files this repo's git index tracks, and for the nzyme submodule that is a
        // single gitlink — so a change inside `nzyme/`, committed or not, would not invalidate cached
        // builds. These hash the submodule's tree explicitly (nzyme/docs/submodule-setup.md#nx).
        "submoduleDefault": [
            {
                "runtime": "{ git -C nzyme ls-tree -r HEAD; git -C nzyme diff --binary HEAD; git -C nzyme ls-files --others --exclude-standard | git -C nzyme hash-object --stdin-paths; } | git hash-object --stdin"
            }
        ],
        // The same, excluding test files and snapshots, so editing them does not invalidate production builds.
        "submoduleProduction": [
            {
                "runtime": "{ git -C nzyme ls-tree -r HEAD | grep -Ev '\\.(test|spec)\\.[jt]sx?$|/__snapshots__/|\\.snap$'; git -C nzyme diff --binary HEAD -- . ':(exclude,glob)**/*.test.*' ':(exclude,glob)**/*.spec.*' ':(exclude,glob)**/__snapshots__/**' ':(exclude,glob)**/*.snap'; git -C nzyme ls-files --others --exclude-standard -- . ':(exclude,glob)**/*.test.*' ':(exclude,glob)**/*.spec.*' ':(exclude,glob)**/__snapshots__/**' ':(exclude,glob)**/*.snap' | git -C nzyme hash-object --stdin-paths; } | git hash-object --stdin"
            }
        ],
        "production": [
            "{projectRoot}/**/*",
            "sharedGlobals",
            "submoduleProduction",
            "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)",
            "!{projectRoot}/**/__snapshots__/**",
            "!{projectRoot}/**/*.snap"
        ],
        "localEnvironment": [
            {
                "env": "ENV"
            }
        ],
        // A gitignored file that changes a build's output (an app's `.env.<ENV>` baked into its
        // bundle) is invisible to a fileset input: Nx hashes only git-visible files. The package that
        // reads such a file overrides this name in its own `package.json` with a `runtime` input
        // hashing the file. Empty here, so packages that bake nothing are not invalidated by it.
        "appEnvironment": []
    },
    "targetDefaults": {
        "build": {
            "cache": true,
            "inputs": ["production", "^production", "localEnvironment", "appEnvironment"],
            "outputs": [
                "{projectRoot}/dist",
                "{projectRoot}/dist-cjs",
                "{projectRoot}/.output",
                "{projectRoot}/storybook-static",
                "{projectRoot}/*.tsbuildinfo"
            ],
            "dependsOn": ["^build"]
        },
        "prep": {
            "cache": true,
            "inputs": ["default", "^default", "localEnvironment"],
            "outputs": ["{projectRoot}/.nuxt"]
        },
        "typecheck": {
            "cache": true,
            "inputs": ["default", "^default", "localEnvironment"],
            "dependsOn": ["prep"]
        },
        "test:stories": {
            "cache": true,
            "inputs": ["default", "^default", "localEnvironment"]
        },
        "codegen": {
            "cache": false
        },
        "dev": {
            "cache": false,
            "continuous": true
        },
        "watch": {
            "cache": false,
            "continuous": true
        }
    },
    // Nx CLI usage analytics go to www.google-analytics.com; nothing here needs them.
    "analytics": false,
    // No Nx daemon: it never exits and watches the whole tree, and every worktree spawns its own —
    // with several Paseo worktrees that drained the machine overnight. Only an explicit
    // `NX_DAEMON=true` overrides this.
    "useDaemonProcess": false
}
