{
    "name": "@nzyme/fetch-utils",
    "version": "0.14.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/kedrzu/nzyme.git"
    },
    "license": "MIT",
    "author": "Michał Kędrzyński <m.kedrzynski@gmail.com>",
    "sideEffects": false,
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./*.js": {
            "types": "./dist/*.d.ts",
            "import": "./dist/*.js",
            "default": "./dist/*.js",
            "source": "./src/*.ts"
        }
    },
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build:cjs": "tsc --build ./tsconfig.cjs.json",
        "build:esm": "tsc --build ./tsconfig.esm.json",
        "typecheck": "tsc --noEmit --project tsconfig.check.json",
        "lint": "prettier ./src --write && bun typecheck && eslint . --fix --cache"
    },
    "dependencies": {
        "@nzyme/types": "0.14.0",
        "@nzyme/xml-utils": "0.14.0",
        "fast-xml-parser": "5.3.6",
        "ufo": "1.6.3"
    },
    "devDependencies": {
        "@nzyme/eslint": "0.14.0",
        "@nzyme/tsconfig": "0.14.0",
        "@types/node": "25.2.3",
        "eslint": "9.39.2",
        "prettier": "3.8.1",
        "typescript": "5.9.3"
    },
    "publishConfig": {
        "access": "public"
    },
    "nzyme": {
        "cjs": true
    }
}
