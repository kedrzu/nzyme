{
    "tabWidth": 4,
    "singleQuote": true,
    "printWidth": 120,
    "arrowParens": "avoid",
    "trailingComma": "all",
    "endOfLine": "lf",
    "singleAttributePerLine": true,
    "ignorePatterns": [
        "dist",
        ".output",
        ".nuxt",
        "node_modules",
        "*.loc.ts",
        "coverage",
        "**/__fixtures__/**",
        "*.md"
    ],
    "overrides": [
        {
            "files": ["*.yml", "*.yaml", "*.html", "*.vue"],
            "options": {
                "tabWidth": 2
            }
        }
    ]
}
