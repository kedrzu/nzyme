{
    "name": "@nzyme/vue-i18n",
    "version": "0.14.0",
    "license": "MIT",
    "author": "Michał Kędrzyński <m.kedrzynski@gmail.com>",
    "repository": {
        "type": "git",
        "url": "https://github.com/kedrzu/nzyme.git"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./*.js": "./src/*.ts",
        "./*.jsx": "./src/*.tsx",
        "./*.vue": "./src/*.vue"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsgo --build tsconfig.esm.json",
        "lint": "eslint . --fix --cache",
        "format": "oxfmt ./src > /dev/null"
    },
    "dependencies": {
        "@nzyme/i18n": "0.14.0",
        "@nzyme/i18n-core": "0.14.0",
        "@nzyme/types": "0.14.0",
        "@nzyme/vue-ioc": "0.14.0",
        "vue": "3.5.34"
    },
    "devDependencies": {
        "@nzyme/eslint": "0.14.0",
        "@nzyme/tsconfig": "0.14.0",
        "@types/node": "25.5.0",
        "@typescript/native-preview": "^7.0.0-dev.20260428.1",
        "eslint": "10.1.0",
        "oxfmt": "0.50.0",
        "vite": "7.3.1"
    }
}
