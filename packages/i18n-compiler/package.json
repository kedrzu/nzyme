{
    "name": "@nzyme/i18n-compiler",
    "version": "0.15.0",
    "description": "Compiles .loc.yaml translations to .loc.ts",
    "license": "MIT",
    "author": "Michał Kędrzyński <m.kedrzynski@gmail.com>",
    "repository": {
        "type": "git",
        "url": "https://github.com/kedrzu/nzyme.git"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "sideEffects": false,
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./*.js": {
            "types": "./dist/*.d.ts",
            "import": "./dist/*.js",
            "source": "./src/*.ts",
            "default": "./dist/*.js"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsgo --build tsconfig.esm.json",
        "format": "oxfmt ./src > /dev/null"
    },
    "dependencies": {
        "@nzyme/i18n-core": "workspace:*",
        "@nzyme/project-utils": "workspace:*",
        "@nzyme/utils": "workspace:*",
        "vitest": "4.1.10",
        "yaml": "2.9.1"
    },
    "devDependencies": {
        "@nzyme/tsconfig": "workspace:*",
        "@nzyme/typography": "workspace:*",
        "@types/bun": "^1.4.2",
        "@types/node": "26.6.4",
        "@typescript/native-preview": "^7.0.0-dev.20260707.2",
        "oxfmt": "0.71.0"
    }
}
