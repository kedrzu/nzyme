{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "./esm.json",
    "compilerOptions": {
        "useDefineForClassFields": true,
        "lib": ["DOM", "DOM.Iterable", "ESNext"],
        "allowJs": false,
        "esModuleInterop": false,
        "allowSyntheticDefaultImports": true,
        "jsx": "react-jsx"
    }
}
