{
    "name": "@nzyme/ioc-testing",
    "version": "0.14.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/kedrzu/nzyme.git"
    },
    "license": "MIT",
    "author": "Michał Kędrzyński <m.kedrzynski@gmail.com>",
    "sideEffects": false,
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./*.js": {
            "types": "./dist/*.d.ts",
            "import": "./dist/*.js",
            "source": "./src/*.ts",
            "default": "./dist/*.js"
        }
    },
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc --build tsconfig.esm.json",
        "lint": "prettier ./src --write > /dev/null && eslint . --fix --cache"
    },
    "dependencies": {
        "@nzyme/ioc": "0.14.0",
        "@nzyme/logging": "0.14.0"
    },
    "devDependencies": {
        "@nzyme/eslint": "0.14.0",
        "@nzyme/tsconfig": "0.14.0",
        "@types/node": "^25.3.1",
        "eslint": "9.39.2",
        "prettier": "3.8.1",
        "typescript": "5.9.3"
    },
    "publishConfig": {
        "access": "public"
    },
    "nzyme": {
        "cjs": true
    }
}
