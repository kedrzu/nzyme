{
    "name": "@nzyme/trace",
    "version": "0.15.1",
    "description": "Execution tracing for test selection: a Bun preload recording which source files run under which test label, and the Playwright fixture and reporter attributing them to tests",
    "license": "MIT",
    "author": "Michał Kędrzyński <m.kedrzynski@gmail.com>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/kedrzu/nzyme.git"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "sideEffects": [
        "./dist/probe/preload.js",
        "./src/probe/preload.ts",
        "./dist/fs/fsPreload.js",
        "./src/fs/fsPreload.ts"
    ],
    "exports": {
        "./preload": {
            "types": "./dist/probe/preload.d.ts",
            "source": "./src/probe/preload.ts",
            "import": "./dist/probe/preload.js",
            "default": "./dist/probe/preload.js"
        },
        "./fs-preload": {
            "types": "./dist/fs/fsPreload.d.ts",
            "source": "./src/fs/fsPreload.ts",
            "import": "./dist/fs/fsPreload.js",
            "default": "./dist/fs/fsPreload.js"
        },
        "./*.js": {
            "types": "./dist/*.d.ts",
            "source": "./src/*.ts",
            "import": "./dist/*.js",
            "default": "./dist/*.js"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsgo --build tsconfig.esm.json",
        "format": "oxfmt ./src > /dev/null"
    },
    "dependencies": {
        "@jridgewell/trace-mapping": "^0.3.31",
        "@nzyme/affected": "workspace:*",
        "@nzyme/project-utils": "workspace:*",
        "@nzyme/utils": "workspace:*",
        "oxc-parser": "^0.152.0"
    },
    "devDependencies": {
        "@nzyme/tsconfig": "workspace:*",
        "@playwright/test": "^1.64.1",
        "@types/bun": "^1.4.5",
        "@types/node": "26.6.6",
        "@typescript/native-preview": "^7.0.0-dev.20260707.2",
        "effect": "^4.1.2",
        "oxfmt": "0.79.0"
    },
    "peerDependencies": {
        "@playwright/test": "^1.64.1",
        "effect": "^4.1.2"
    },
    "peerDependenciesMeta": {
        "@playwright/test": {
            "optional": true
        },
        "effect": {
            "optional": true
        }
    }
}
