{
    "name": "@nzyme/project-utils",
    "version": "0.14.0",
    "license": "MIT",
    "author": "Michał Kędrzyński <m.kedrzynski@gmail.com>",
    "repository": {
        "type": "git",
        "url": "https://github.com/kedrzu/nzyme.git"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js",
            "source": "./src/index.ts"
        },
        "./*.js": {
            "types": "./dist/*.d.ts",
            "import": "./dist/*.js",
            "source": "./src/*.ts",
            "default": "./dist/*.js"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsgo --build tsconfig.esm.json",
        "lint": "eslint . --fix --cache",
        "format": "oxfmt ./src > /dev/null"
    },
    "dependencies": {
        "@manypkg/find-root": "3.1.0",
        "@nzyme/utils": "0.14.0",
        "chalk": "5.6.2",
        "dotenv": "17.4.2",
        "eslint": "10.1.0",
        "execa": "9.6.1",
        "fs-extra": "11.3.5",
        "oxfmt": "0.46.0",
        "parse-gitignore": "2.0.0",
        "pkg-types": "2.3.1"
    },
    "devDependencies": {
        "@nzyme/eslint": "0.14.0",
        "@nzyme/tsconfig": "0.14.0",
        "@types/fs-extra": "11.0.4",
        "@types/node": "25.5.0",
        "@types/parse-gitignore": "1.0.2",
        "@typescript/native-preview": "^7.0.0-dev.20260428.1"
    }
}
