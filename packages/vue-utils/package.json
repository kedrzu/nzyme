{
    "name": "@nzyme/vue-utils",
    "version": "0.14.0",
    "description": "Vue composition utilities (classProp, navigateToUrl, …)",
    "license": "MIT",
    "author": "Michał Kędrzyński <m.kedrzynski@gmail.com>",
    "repository": {
        "type": "git",
        "url": "https://github.com/kedrzu/nzyme.git"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "sideEffects": false,
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./*.js": {
            "types": "./dist/*.d.ts",
            "import": "./dist/*.js",
            "source": "./src/*.ts",
            "default": "./dist/*.js"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsgo --build tsconfig.esm.json",
        "format": "oxfmt ./src > /dev/null"
    },
    "dependencies": {
        "@nzyme/dom-utils": "0.14.0",
        "@nzyme/types": "0.14.0",
        "@nzyme/utils": "0.14.0",
        "@nzyme/zchema": "0.14.0",
        "@standard-schema/spec": "1.1.0",
        "lodash.debounce": "4.0.8",
        "vue": "3.5.41"
    },
    "devDependencies": {
        "@nzyme/tsconfig": "0.14.0",
        "@types/bun": "^1.3.11",
        "@types/lodash.debounce": "4.0.9",
        "@typescript/native-preview": "^7.0.0-dev.20260707.2",
        "oxfmt": "0.62.0"
    },
    "nzyme": {
        "cjs": true
    }
}
