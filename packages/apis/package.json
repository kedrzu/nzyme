{
    "name": "@nzyme/apis",
    "version": "0.14.0",
    "description": "Shipping carrier API clients and types (DHL, HERE Maps, InPost)",
    "license": "MIT",
    "author": "Michał Kędrzyński <m.kedrzynski@gmail.com>",
    "repository": {
        "type": "git",
        "url": "https://github.com/kedrzu/nzyme.git"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "sideEffects": false,
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "typesVersions": {
        "*": {
            "*": [
                "./dist/*.d.ts"
            ]
        }
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./*.js": {
            "types": "./dist/*.d.ts",
            "import": "./dist/*.js",
            "source": "./src/*.ts",
            "default": "./dist/*.js"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsgo --build tsconfig.esm.json",
        "format": "oxfmt ./src > /dev/null"
    },
    "dependencies": {
        "@nzyme/fetch-utils": "0.14.0",
        "@nzyme/types": "0.14.0"
    },
    "devDependencies": {
        "@nzyme/tsconfig": "0.14.0",
        "@typescript/native-preview": "^7.0.0-dev.20260707.2",
        "oxfmt": "0.62.0"
    }
}
