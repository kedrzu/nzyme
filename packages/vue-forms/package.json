{
    "name": "@nzyme/vue-forms",
    "version": "0.15.0",
    "description": "Vue form state and validation (useForm, useFormFields)",
    "license": "MIT",
    "author": "Michał Kędrzyński <m.kedrzynski@gmail.com>",
    "repository": {
        "type": "git",
        "url": "https://github.com/kedrzu/nzyme.git"
    },
    "files": [
        "src",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx",
        "css"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "imports": {
        "#css/*": "./css/*"
    },
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "source": "./src/index.ts",
            "import": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./shims": {
            "types": "./src/shims.d.ts"
        },
        "./*.js": {
            "types": "./src/*.ts",
            "import": "./src/*.ts",
            "source": "./src/*.ts",
            "default": "./src/*.ts"
        },
        "./*.jsx": {
            "types": "./src/*.tsx",
            "import": "./src/*.tsx",
            "source": "./src/*.tsx",
            "default": "./src/*.tsx"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsgo --build tsconfig.esm.json",
        "format": "oxfmt ./src > /dev/null"
    },
    "dependencies": {
        "@nzyme/dom-utils": "workspace:*",
        "@nzyme/i18n": "workspace:*",
        "@nzyme/i18n-core": "workspace:*",
        "@nzyme/money": "workspace:*",
        "@nzyme/types": "workspace:*",
        "@nzyme/utils": "workspace:*",
        "@nzyme/validation": "workspace:*",
        "@nzyme/vue-i18n": "workspace:*",
        "@nzyme/vue-ioc": "workspace:*",
        "@nzyme/vue-utils": "workspace:*",
        "@vueuse/core": "15.0.0",
        "imask": "7.6.1",
        "libphonenumber-js": "1.13.14",
        "vue": "3.5.43",
        "vue-imask": "7.6.1",
        "vue-router": "5.3.1"
    },
    "devDependencies": {
        "@nzyme/tsconfig": "workspace:*",
        "@nzyme/vue-ioc": "workspace:*",
        "@types/bun": "^1.4.2",
        "@types/node": "26.6.4",
        "@typescript/native-preview": "^7.0.0-dev.20260707.2",
        "oxfmt": "0.71.0",
        "vite": "7.3.6"
    }
}
