{
    "name": "@nzyme/vue",
    "version": "0.15.1",
    "description": "Vue framework primitives and utilities",
    "license": "MIT",
    "author": "Michał Kędrzyński <m.kedrzynski@gmail.com>",
    "repository": {
        "type": "git",
        "url": "https://github.com/kedrzu/nzyme.git"
    },
    "files": [
        "src",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx",
        "!src/**/*.spec.ts"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "source": "./src/index.ts",
            "import": "./src/index.ts",
            "require": "./src/index.ts"
        },
        "./shims": {
            "types": "./src/shims.d.ts"
        },
        "./*.js": "./src/*.ts",
        "./*.jsx": "./src/*.tsx",
        "./*.vue": "./src/*.vue"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsgo --build tsconfig.esm.json",
        "format": "oxfmt ./src > /dev/null",
        "test:components": "vitest run"
    },
    "dependencies": {
        "@nzyme/dom-utils": "workspace:*",
        "@nzyme/ioc": "workspace:*",
        "@nzyme/types": "workspace:*",
        "@nzyme/utils": "workspace:*",
        "@nzyme/vue-ioc": "workspace:*",
        "@nzyme/vue-utils": "workspace:*",
        "@vueuse/core": "^15.0.0",
        "lodash.debounce": "^4.0.8",
        "type-fest": "^5.10.0"
    },
    "devDependencies": {
        "@nzyme/tsconfig": "workspace:*",
        "@types/bun": "^1.4.4",
        "@types/lodash.debounce": "4.0.9",
        "@types/node": "26.6.6",
        "@typescript/native-preview": "^7.0.0-dev.20260707.2",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vitejs/plugin-vue-jsx": "^5.1.6",
        "@vitest/browser-playwright": "^4.1.12",
        "oxfmt": "0.76.0",
        "playwright": "^1.64.1",
        "sass": "^1.107.1",
        "vite": "7.3.7",
        "vitest": "^4.1.12",
        "vitest-browser-vue": "^3.1.0",
        "vue": "^3.5.44"
    },
    "peerDependencies": {
        "vue": "^3.5.44"
    }
}
